#!/bin/bash
echo "🔍 Validating commit messages before push..."
# Excludes auto-generated merge commits (e.g. GitHub's "Update branch"), matching
# the CI commit-lint job in .github/workflows/commit-lint.yml.
COMMITS=$(git log origin/main..HEAD --pretty=format:%s | grep -v "^Merge ")
if [[ -z "$COMMITS" ]]; then
  echo "✅ No new commits to validate"
  exit 0
fi
APPS="Main|Event_Tracker|Blog_Posts|Recipes|Dossier|Photo_Album"
TYPES="feat|fix|refactor|test|chore|docs|style|perf|build|revert"
REGEX="^(${APPS}):[[:space:]]+(${TYPES}):[[:space:]]+(.{10,})$"
while read -r COMMIT; do
  if [[ ! $COMMIT =~ $REGEX ]]; then
    echo "❌ Invalid commit found:"
    echo "$COMMIT"
    exit 1
  fi
done <<< "$COMMITS"
echo "✅ All commits valid"
