<div class="page-header page-header--centered">
  <div class="page-header__top">
    <h1 class="page-title">Cookbook</h1>
  </div>
  <p class="page-header__subtitle">
    Collect, cook, and share your favourite recipes.
  </p>
</div>

<%= render "shared/app_landing",
      app_name: "Cookbook",
      hero_image: "cookbook-hero.png",
      about: [
        { title: "Write It Down Once",
          body: "Keep every recipe in one place: ingredients grouped by each part " \
                "of the dish, step-by-step instructions with photos, and how many " \
                "it serves or makes." },
        { title: "Find Something to Cook",
          body: "Browse by cuisine or food type, or filter by language, cook time " \
                "and more, whether it's tonight's dinner or this weekend's baking." },
        { title: "Share What You Like",
          body: "Recipes stay as drafts, visible only to you, until you publish " \
                "them. Guests see public recipes; signed-in users see more, following " \
                "the same contacts and classification rules as the rest of the site, " \
                "and can react and comment." }
      ] %>
