<div class="page-header page-header--centered">
  <div class="page-header__top">
    <h1 class="page-title">Chronicle</h1>
  </div>
  <p class="page-header__subtitle">
    Write, publish, and share blog posts.
  </p>
</div>

<%= render "shared/app_landing",
      app_name: "Chronicle",
      hero_image: "chronicle-hero.png",
      about: [
        "Chronicle lets you write blog posts as Markdown or with a rich " \
        "formatted editor — text, images, videos, tables, links, and " \
        "embedded documents all included.",
        "Posts start as drafts, visible only to their author(s), until " \
        "you're ready to publish. Share ownership with co-authors, " \
        "organize with categories, and let readers comment and like.",
        "Guest visitors see publicly available posts; signed-in users " \
        "get more, following the same contacts and classification rules " \
        "as the rest of the site."
      ] %>
