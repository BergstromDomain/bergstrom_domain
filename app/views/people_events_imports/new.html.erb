<%# app/views/people_events_imports/new.html.erb %>

<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Import People and Events</h1>
  </div>
</div>

<div class="show-panel" data-testid="import-panel">
  <p>Upload a CSV file to create or update people and events. Each row represents one person and
    one event — download the template below for the exact column layout, including one
    placeholder row per existing Event Type.</p>

  <%= form_with url: people_events_imports_path, method: :post, data: { turbo: false }, html: { multipart: true } do |f| %>
    <div class="form-group">
      <%= f.label :file, "CSV file", class: "sr-only" %>
      <%= f.file_field :file, accept: ".csv", class: "form-control", id: "import-file-input",
            data: { testid: "import-file-input" } %>
    </div>

    <div class="show-panel show-panel--actions">
      <%= link_to template_people_events_imports_path, class: "btn btn-secondary", data: { testid: "import-template-link" } do %>
        <%= lucide_icon("file-down", size: 16) %> Download CSV Template
      <% end %>
      <button type="submit" class="btn btn-primary" data-testid="import-button">
        <%= lucide_icon("upload", size: 16) %> Import
      </button>
    </div>
  <% end %>

  <% if @import_result %>
    <div class="show-panel" data-testid="import-results">
      <h2 class="show-panel__heading">Import Results</h2>
      <p data-testid="import-summary">
        <%= pluralize(@import_result.imported_count, "row") %> imported,
        <%= pluralize(@import_result.failed_count, "row") %> failed.
      </p>

      <% if @import_result.errors.any? %>
        <div class="data-table-wrapper">
          <table class="data-table" data-testid="import-errors-table">
            <thead>
              <tr>
                <th>Row</th>
                <th>Error</th>
              </tr>
            </thead>
            <tbody>
              <% @import_result.errors.each do |error| %>
                <tr data-testid="import-error-row">
                  <td><%= error[:row] %></td>
                  <td><%= error[:message] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
