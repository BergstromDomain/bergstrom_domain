<%# app/views/blog_categories/show.html.erb %>

<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title" data-testid="blog-category-name"><%= @blog_category.name %></h1>
  </div>
</div>

<%# Main div — icon + description %>
<div class="show-panel" data-testid="show-panel-main">
  <div class="show-panel__section">
    <span class="event-type-icon-large" data-testid="blog-category-icon">
      <%= lucide_icon(@blog_category.icon, size: 64) %>
    </span>
  </div>

  <div class="show-panel__section">
    <h2 class="show-panel__heading">Description</h2>
    <p data-testid="blog-category-description">
      <%= @blog_category.description.presence || "—" %>
    </p>
  </div>
</div>

<%# Metadata div %>
<div class="show-panel" data-testid="show-panel-metadata">
  <div class="show-meta-row">
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Blog Category Name</h3>
      <p class="show-meta-cell__value" data-testid="blog-category-name-value">
        <%= @blog_category.name %>
      </p>
    </div>
  </div>
</div>

<%# Actions div %>
<div class="show-panel show-panel--actions" data-testid="show-panel-actions">
  <%= link_to blog_categories_path, class: "btn btn-secondary" do %>
    <%= lucide_icon("arrow-left", size: 16) %> Back to Blog Categories
  <% end %>

  <% if @policy.can_update? %>
    <span class="btn-divider">|</span>
    <%= link_to edit_blog_category_path(@blog_category), class: "btn btn-secondary" do %>
      <%= lucide_icon("pencil", size: 16) %> Edit Blog Category
    <% end %>
  <% end %>

  <% if @policy.can_delete? %>
    <span class="btn-divider">|</span>
    <%= button_to blog_category_path(@blog_category),
          method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Delete #{@blog_category.name}? This cannot be undone." } do %>
      <%= lucide_icon("trash-2", size: 16) %> Delete Blog Category
    <% end %>
  <% end %>
</div>
