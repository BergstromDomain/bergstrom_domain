<%# app/views/blog_categories/edit.html.erb %>

<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title"><%= @blog_category.name %></h1>
  </div>
</div>

<%= form_with model: @blog_category, class: "resource-form" do |f| %>
  <% if @blog_category.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p><%= pluralize(@blog_category.errors.count, "error") %> prevented this blog category from being saved:</p>
      <ul>
        <% @blog_category.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Main div — name + icon + description %>
  <div class="show-panel" data-testid="edit-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Name</h2>
      <div class="form-group">
        <%= f.label :name, class: "sr-only" %>
        <%= f.text_field :name,
              class: "form-control #{'form-control--error' if @blog_category.errors[:name].any?}",
              data: { testid: "name-field" } %>
        <% if @blog_category.errors[:name].any? %>
          <span class="field-error" data-testid="field-error">
            <%= @blog_category.errors[:name].first %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="show-panel__section">
      <% if BlogCategory::LUCIDE_VALID_ICONS.include?(@blog_category.icon) %>
        <span class="event-type-icon-large">
          <%= lucide_icon(@blog_category.icon, size: 64) %>
        </span>
      <% end %>
    </div>

    <div class="show-panel__section">
      <h2 class="show-panel__heading">Description</h2>
      <div class="form-group">
        <%= f.label :description, class: "sr-only" %>
        <%= f.text_area :description,
              class: "form-control",
              rows: 4,
              data: { testid: "description-field" } %>
      </div>
    </div>
  </div>

  <%# Metadata div %>
  <div class="show-panel" data-testid="edit-panel-metadata">
    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Icon Name</h3>
      <div class="form-group">
        <%= f.label :icon, class: "sr-only" %>
        <%= f.text_field :icon,
              placeholder: "e.g. cpu, plane, wallet",
              class: "form-control #{'form-control--error' if @blog_category.errors[:icon].any?}",
              data: { testid: "icon-field" } %>
        <% if @blog_category.errors[:icon].any? %>
          <span class="field-error" data-testid="field-error">
            <%= @blog_category.errors[:icon].first %>
          </span>
        <% end %>
        <p class="form-hint">
          Find icon names at <%= link_to "lucide.dev/icons", "https://lucide.dev/icons/",
                target: "_blank", rel: "noopener noreferrer" %>.
        </p>
      </div>
    </div>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="edit-panel-actions">
    <%= link_to blog_category_path(@blog_category), class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> Update Blog Category
    </button>
  </div>
<% end %>
