<%# Locals: panel ("new"/"edit"), submit_label, cancel_path %>
<%= form_with model: cuisine, class: "resource-form" do |f| %>
  <% if cuisine.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p><%= pluralize(cuisine.errors.count, "error") %> prevented this cuisine from being saved:</p>
      <ul>
        <% cuisine.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Main div — name + flag preview + description %>
  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Name</h2>
      <div class="form-group">
        <%= f.label :name, class: "sr-only" %>
        <%= f.text_field :name,
              class: "form-control #{'form-control--error' if cuisine.errors[:name].any?}",
              data: { testid: "name-field" } %>
        <% if cuisine.errors[:name].any? %>
          <span class="field-error" data-testid="field-error"><%= cuisine.errors[:name].first %></span>
        <% end %>
      </div>
    </div>

    <% if cuisine.flag.present? && cuisine.errors[:flag].none? %>
      <div class="show-panel__section" data-testid="flag-preview">
        <%= render "shared/flag_badge", flag: cuisine.flag, badge: "utensils", large: true %>
      </div>
    <% end %>

    <div class="show-panel__section">
      <h2 class="show-panel__heading">Description</h2>
      <div class="form-group">
        <%= f.label :description, class: "sr-only" %>
        <%= f.text_area :description,
              class: "form-control #{'form-control--error' if cuisine.errors[:description].any?}",
              rows: 4,
              data: { testid: "description-field" } %>
        <% if cuisine.errors[:description].any? %>
          <span class="field-error" data-testid="field-error"><%= cuisine.errors[:description].first %></span>
        <% end %>
      </div>
    </div>
  </div>

  <%# Metadata div %>
  <div class="show-panel" data-testid="<%= panel %>-panel-metadata">
    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Flag</h3>
      <div class="form-group">
        <%= f.label :flag, class: "sr-only" %>
        <%= f.text_field :flag,
              placeholder: "e.g. 🇸🇪",
              class: "form-control #{'form-control--error' if cuisine.errors[:flag].any?}",
              data: { testid: "flag-field" } %>
        <% if cuisine.errors[:flag].any? %>
          <span class="field-error" data-testid="field-error"><%= cuisine.errors[:flag].first %></span>
        <% end %>
        <p class="form-hint">
          One emoji: a country flag, or e.g. 🌍 for a regional cuisine. Open the emoji picker with
          Win + . (Windows) or Ctrl + Cmd + Space (macOS).
        </p>
      </div>
    </div>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to cancel_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
