<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title" data-testid="cuisine-name"><%= @cuisine.name %></h1>
  </div>
</div>

<div class="page-content--half">
  <%# Main div — flag + description %>
  <div class="show-panel" data-testid="show-panel-main">
    <div class="show-panel__section">
      <%= render "shared/flag_badge", flag: @cuisine.flag, badge: "utensils", large: true, testid: "cuisine-flag" %>
    </div>

    <div class="show-panel__section">
      <h2 class="show-panel__heading">Description</h2>
      <p data-testid="cuisine-description"><%= @cuisine.description %></p>
    </div>
  </div>

  <%# Metadata div %>
  <div class="show-panel" data-testid="show-panel-metadata">
    <div class="show-meta-row">
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Cuisine Name</h3>
        <p class="show-meta-cell__value" data-testid="cuisine-name-value"><%= @cuisine.name %></p>
      </div>
    </div>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="show-panel-actions">
    <%= link_to cuisines_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("arrow-left", size: 16) %> Back
    <% end %>

    <% if @policy.can_update? %>
      <span class="btn-divider">|</span>
      <%= link_to edit_cuisine_path(@cuisine), class: "btn btn-secondary" do %>
        <%= lucide_icon("pencil", size: 16) %> Edit Cuisine
      <% end %>
    <% end %>

    <% if @policy.can_delete? %>
      <span class="btn-divider">|</span>
      <%= button_to cuisine_path(@cuisine),
            method: :delete,
            class: "btn btn-danger",
            data: { turbo_confirm: "Delete #{@cuisine.name}? This cannot be undone." } do %>
        <%= lucide_icon("trash-2", size: 16) %> Delete Cuisine
      <% end %>
    <% end %>
  </div>
</div>
