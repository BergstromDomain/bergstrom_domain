<%# app/views/layouts/_left_nav.html.erb %>
<nav class="left-nav" data-testid="left-nav">
  <% if Current.session %>
    <button type="button" class="left-nav__restore" data-action="left-nav#showNav"
            data-testid="left-nav-restore" aria-label="Show navigation">
      <%= lucide_icon("chevrons-right", size: 20) %>
    </button>
  <% end %>

  <div class="left-nav__content" data-left-nav-target="content"
       <%= 'aria-hidden="true"'.html_safe if Current.session && !Current.session.left_nav_visible? %>>
  <% if Current.session %>
    <button type="button" class="left-nav__collapse" data-action="left-nav#hideNav"
            data-testid="left-nav-collapse" aria-label="Hide navigation">
      <%= lucide_icon("chevrons-left", size: 20) %>
    </button>
  <% end %>

  <% if @left_nav_section == :event_tracker %>

    <%# ── Views ─────────────────────────────────────────────────────────── %>
    <div class="left-nav-section<%= ' left-nav-section--collapsed' if left_nav_section_collapsed?('views') %>">
      <h2 class="left-nav-h2" data-testid="left-nav-views-h2">
        <%= lucide_icon("eye", size: 14) %> Views
        <%= left_nav_section_toggle("views", "left-nav-views-h2") %>
      </h2>

      <div class="left-nav-section__body"<%= ' aria-hidden="true"'.html_safe if left_nav_section_collapsed?('views') %>>
      <h3 class="left-nav-h3" data-testid="left-nav-event-tracker-h3">
        Occasions
      </h3>
      <%= link_to event_tracker_path, class: "left-nav-link" do %>
        <%= lucide_icon("calendar-fold", size: 15) %>
        <span>Occasions</span>
      <% end %>

      <h3 class="left-nav-h3" data-testid="left-nav-events-h3">
        Events
      </h3>
      <%= link_to events_by_day_path, class: "left-nav-link" do %>
        <%= lucide_icon("calendar-clock", size: 15) %>
        <span>Events By Day</span>
      <% end %>
      <%= link_to events_by_week_path, class: "left-nav-link" do %>
        <%= lucide_icon("calendar-days", size: 15) %>
        <span>Events By Week</span>
      <% end %>
      <%= link_to events_by_month_path, class: "left-nav-link" do %>
        <%= lucide_icon("calendars", size: 15) %>
        <span>Events By Month</span>
      <% end %>

      <h3 class="left-nav-h3" data-testid="left-nav-people-h3">
        People
      </h3>
      <%= link_to people_path, class: "left-nav-link" do %>
        <%= lucide_icon("user-star", size: 15) %>
        <span>People</span>
      <% end %>

      <h3 class="left-nav-h3" data-testid="left-nav-reference-data-h3">
        Reference Data
      </h3>
      <%= link_to event_types_path, class: "left-nav-link" do %>
        <%= lucide_icon("boxes", size: 15) %>
        <span>Event Types</span>
      <% end %>
      <%= link_to social_media_platforms_path, class: "left-nav-link" do %>
        <%= lucide_icon("share-2", size: 15) %>
        <span>Social Media Platforms</span>
      <% end %>
      </div>
    </div>

    <hr class="left-nav-divider">

    <%# ── Actions (Content Creator and above) ───────────────────────────── %>
    <% if can_see_left_nav_actions? %>
      <% event_policy = Policy.new(current_user, :event_tracker) %>

      <div class="left-nav-section<%= ' left-nav-section--collapsed' if left_nav_section_collapsed?('actions') %>">
        <h2 class="left-nav-h2" data-testid="left-nav-actions-h2">
          <%= lucide_icon("cog", size: 14) %> Actions
          <%= left_nav_section_toggle("actions", "left-nav-actions-h2") %>
        </h2>

        <div class="left-nav-section__body"<%= ' aria-hidden="true"'.html_safe if left_nav_section_collapsed?('actions') %>>
        <% if event_policy.can_create? || current_user&.can_administer? %>
          <h3 class="left-nav-h3" data-testid="left-nav-new-h3">
            New
          </h3>
        <% end %>

        <% if event_policy.can_create? %>
          <%= link_to new_event_path, class: "left-nav-link" do %>
            <%= lucide_icon("calendar-plus", size: 15) %>
            <span>Create Event</span>
          <% end %>
          <%= link_to new_person_path, class: "left-nav-link" do %>
            <%= lucide_icon("user-plus", size: 15) %>
            <span>Create Person</span>
          <% end %>
        <% end %>

        <% if current_user&.can_administer? %>
          <%= link_to new_event_type_path, class: "left-nav-link" do %>
            <%= lucide_icon("box", size: 15) %>
            <span>Create Event Type</span>
          <% end %>
          <%= link_to new_social_media_platform_path, class: "left-nav-link" do %>
            <%= lucide_icon("share-2", size: 15) %>
            <span>Create Social Media Platform</span>
          <% end %>
        <% end %>

        <%# ── Import & Export ────────────────────────────────────────────── %>
        <h3 class="left-nav-h3" data-testid="left-nav-import-export-h3">
          Import &amp; Export
        </h3>

        <%= link_to import_export_path, class: "left-nav-link" do %>
          <%= lucide_icon("upload", size: 15) %>
          <span>Import People And Events</span>
        <% end %>
        <%= link_to import_export_path, class: "left-nav-link" do %>
          <%= lucide_icon("download", size: 15) %>
          <span>Download People And Events</span>
        <% end %>
        </div>
      </div>

      <hr class="left-nav-divider">
    <% end %>

    <%# ── Documentation ──────────────────────────────────────────────────── %>
    <div class="left-nav-section<%= ' left-nav-section--collapsed' if left_nav_section_collapsed?('documentation') %>">
      <h2 class="left-nav-h2" data-testid="left-nav-documentation-h2">
        <%= lucide_icon("book-open", size: 14) %> Documentation
        <%= left_nav_section_toggle("documentation", "left-nav-documentation-h2") %>
      </h2>

      <div class="left-nav-section__body"<%= ' aria-hidden="true"'.html_safe if left_nav_section_collapsed?('documentation') %>>
      <h3 class="left-nav-h3" data-testid="left-nav-how-to-h3">
        How To
      </h3>

      <%= link_to user_guide_path, class: "left-nav-link" do %>
        <%= lucide_icon("book-open-check", size: 15) %>
        <span>User Guide</span>
      <% end %>
      </div>
    </div>

  <% elsif @left_nav_section == :settings %>

    <%# ── Settings ──────────────────────────────────────────────────────── %>
    <div class="left-nav-section<%= ' left-nav-section--collapsed' if left_nav_section_collapsed?('settings') %>">
      <h2 class="left-nav-h2" data-testid="left-nav-settings-h2">
        <%= lucide_icon("cog", size: 14) %> Settings
        <%= left_nav_section_toggle("settings", "left-nav-settings-h2") %>
      </h2>

      <div class="left-nav-section__body"<%= ' aria-hidden="true"'.html_safe if left_nav_section_collapsed?('settings') %>>
      <h3 class="left-nav-h3" data-testid="left-nav-user-settings-h3">
        <%= lucide_icon("user-cog", size: 13) %> User Settings
      </h3>
      <%= link_to settings_path, class: "left-nav-link" do %>
        <%= lucide_icon("user-round-cog", size: 15) %>
        <span>User Details</span>
      <% end %>
      <%= link_to preferences_settings_path, class: "left-nav-link" do %>
        <%= lucide_icon("settings-2", size: 15) %>
        <span>Preferences</span>
      <% end %>

      <h3 class="left-nav-h3" data-testid="left-nav-contact-management-h3">
        <%= lucide_icon("contact-round", size: 13) %> Contact Management
      </h3>
      <%= link_to contacts_path, class: "left-nav-link" do %>
        <%= lucide_icon("users", size: 15) %>
        <span>Contacts</span>
      <% end %>

      <h3 class="left-nav-h3" data-testid="left-nav-app-settings-h3">
        <%= lucide_icon("monitor-cog", size: 13) %> App Settings
      </h3>
      <%= link_to chronicle_settings_path, class: "left-nav-link" do %>
        <%= lucide_icon("notepad-text", size: 15) %>
        <span>Chronicle Settings</span>
      <% end %>
      <%= link_to occasions_settings_path, class: "left-nav-link" do %>
        <%= lucide_icon("calendar-range", size: 15) %>
        <span>Occasions Settings</span>
      <% end %>
      </div>
    </div>

  <% elsif @left_nav_section == :blog_posts %>

    <%# ── Views ─────────────────────────────────────────────────────────── %>
    <div class="left-nav-section<%= ' left-nav-section--collapsed' if left_nav_section_collapsed?('views') %>">
      <h2 class="left-nav-h2" data-testid="left-nav-views-h2">
        <%= lucide_icon("eye", size: 14) %> Views
        <%= left_nav_section_toggle("views", "left-nav-views-h2") %>
      </h2>

      <div class="left-nav-section__body"<%= ' aria-hidden="true"'.html_safe if left_nav_section_collapsed?('views') %>>
      <h3 class="left-nav-h3" data-testid="left-nav-chronicle-h3">Chronicle</h3>
      <%= link_to chronicle_path, class: "left-nav-link" do %>
        <%= lucide_icon("newspaper", size: 15) %>
        <span>Chronicle</span>
      <% end %>

      <h3 class="left-nav-h3" data-testid="left-nav-posts-h3">Blog Posts</h3>
      <%= link_to blog_posts_path, class: "left-nav-link" do %>
        <%= lucide_icon("list-tree", size: 15) %>
        <span>Browse Blog Posts</span>
      <% end %>
      <%= link_to filter_blog_posts_path, class: "left-nav-link" do %>
        <%= lucide_icon("list-filter", size: 15) %>
        <span>Filter Blog Posts</span>
      <% end %>

      <% if current_user %>
        <h3 class="left-nav-h3" data-testid="left-nav-my-posts-h3">My Blog Posts</h3>
        <%= link_to filter_blog_posts_path(author_id: current_user.id, published: "published"),
              class: "left-nav-link" do %>
          <%= lucide_icon("file-check", size: 15) %>
          <span>My Published Posts</span>
        <% end %>
        <%= link_to filter_blog_posts_path(author_id: current_user.id, published: "draft"),
              class: "left-nav-link" do %>
          <%= lucide_icon("pencil-line", size: 15) %>
          <span>My Draft Posts</span>
        <% end %>
      <% end %>

      <h3 class="left-nav-h3" data-testid="left-nav-categories-h3">Reference Data</h3>
      <%= link_to blog_categories_path, class: "left-nav-link" do %>
        <%= lucide_icon("boxes", size: 15) %>
        <span>Blog Categories</span>
      <% end %>
      </div>
    </div>

    <% if can_see_left_nav_actions? %>
      <% blog_post_policy = Policy.new(current_user, :blog_posts) %>
      <hr class="left-nav-divider">

      <%# ── Actions (Content Creator and above) ────────────────────────────── %>
      <div class="left-nav-section<%= ' left-nav-section--collapsed' if left_nav_section_collapsed?('actions') %>">
        <h2 class="left-nav-h2" data-testid="left-nav-actions-h2">
          <%= lucide_icon("cog", size: 14) %> Actions
          <%= left_nav_section_toggle("actions", "left-nav-actions-h2") %>
        </h2>

        <div class="left-nav-section__body"<%= ' aria-hidden="true"'.html_safe if left_nav_section_collapsed?('actions') %>>
        <% if blog_post_policy.can_create? || current_user&.can_administer? %>
          <h3 class="left-nav-h3" data-testid="left-nav-new-h3">
            New
          </h3>
        <% end %>

        <% if blog_post_policy.can_create? %>
          <%= link_to new_blog_post_path, class: "left-nav-link" do %>
            <%= lucide_icon("file-plus-2", size: 15) %>
            <span>Create A Blog Post</span>
          <% end %>
        <% end %>

        <% if current_user&.can_administer? %>
          <%= link_to new_blog_category_path, class: "left-nav-link" do %>
            <%= lucide_icon("box", size: 15) %>
            <span>Create A Blog Category</span>
          <% end %>
          <%= link_to deleted_blog_posts_path, class: "left-nav-link" do %>
            <%= lucide_icon("trash-2", size: 15) %>
            <span>Deleted Posts</span>
          <% end %>
        <% end %>
        </div>
      </div>
    <% end %>

    <hr class="left-nav-divider">

    <%# ── Documentation ──────────────────────────────────────────────────── %>
    <div class="left-nav-section<%= ' left-nav-section--collapsed' if left_nav_section_collapsed?('documentation') %>">
      <h2 class="left-nav-h2" data-testid="left-nav-documentation-h2">
        <%= lucide_icon("book-open", size: 14) %> Documentation
        <%= left_nav_section_toggle("documentation", "left-nav-documentation-h2") %>
      </h2>

      <div class="left-nav-section__body"<%= ' aria-hidden="true"'.html_safe if left_nav_section_collapsed?('documentation') %>>
      <h3 class="left-nav-h3" data-testid="left-nav-how-to-h3">
        How To
      </h3>

      <%= link_to user_guide_path, class: "left-nav-link" do %>
        <%= lucide_icon("book-open-check", size: 15) %>
        <span>User Guide</span>
      <% end %>
      </div>
    </div>

  <% end %>
  </div>
</nav>