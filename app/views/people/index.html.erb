<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">People</h1>
  </div>
</div>

<nav class="az-nav" data-testid="az-nav">
  <%= link_to "All",
        people_path,
        class: "az-nav__link #{'az-nav__link--active' if @selected_letter.nil?}",
        data: { testid: "az-nav-all" } %>
  <% Person::BUCKET_LETTERS.each do |letter| %>
    <% if @available_letters.include?(letter) %>
      <%= link_to letter,
            people_path(letter: letter),
            class: "az-nav__link #{'az-nav__link--active' if @selected_letter == letter}",
            data: { testid: "az-nav-link" } %>
    <% else %>
      <span class="az-nav__link az-nav__link--disabled"
            data-testid="az-nav-link-disabled"><%= letter %></span>
    <% end %>
  <% end %>
</nav>

<% if authenticated? %>
  <%# ── Classification filter — independent checkboxes, any combination ──── %>
  <%= form_with url: people_path, method: :get, class: "classification-nav",
        data: { controller: "auto-submit", action: "change->auto-submit#submit", testid: "classification-nav" } do %>
    <%= hidden_field_tag :letter, @selected_letter if @selected_letter.present? %>
    <%= hidden_field_tag "classifications[]", "" %>
    <div class="classification-checks">
      <% Person.classifications.keys.each do |classification| %>
        <div class="form-check">
          <%= check_box_tag "classifications[]",
                classification,
                @selected_classifications.include?(classification),
                id: "classification_#{classification}",
                data: { testid: "classification-checkbox-#{classification}" } %>
          <%= label_tag "classification_#{classification}", classification.humanize %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if @people.any? %>
  <div class="data-table-wrapper">
    <table class="data-table" data-testid="people-table">
      <thead>
        <tr>
          <th class="col-thumbnail"></th>
          <th>Name</th>
          <th class="text-center">Event Types</th>
          <th class="text-right">Created By</th>
          <th class="text-right">Classification</th>
          <% if authenticated? %><th class="text-right">Mute Person</th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @people.each do |person| %>
          <tr data-testid="person-row">
            <td class="col-thumbnail" data-testid="person-thumbnail">
              <% if person.image.attached? %>
                <%= link_to person_path(person) do %>
                  <%= image_tag person.image.variant(:thumbnail),
                        alt: person.full_name,
                        class: "table-thumbnail table-thumbnail--person" %>
                <% end %>
              <% else %>
                <%= link_to person_path(person), class: "table-thumbnail-icon table-thumbnail-icon--person" do %>
                  <%= lucide_icon("user", size: 24) %>
                <% end %>
              <% end %>
            </td>
            <td>
              <%= link_to person.full_name,
                    person_path(person),
                    class: "data-table__name-link",
                    data: { testid: "person-name" } %>
            </td>
            <td class="text-center" data-testid="person-event-types">
              <div class="person-icon-group person-icon-group--center">
                <% person.events.includes(:event_type).map(&:event_type).uniq.each do |event_type| %>
                  <%= link_to events_path(event_type_id: event_type.id),
                        class: "person-icon-link",
                        title: event_type.name do %>
                    <%= lucide_icon(event_type.icon, size: 20) %>
                  <% end %>
                <% end %>
              </div>
            </td>
            <td class="text-right" data-testid="person-created-by">
              <span class="created-by">
                <% if person.user.profile_image.attached? %>
                  <%= image_tag person.user.profile_image.variant(:thumbnail),
                        alt: "#{person.user.first_name} #{person.user.last_name}",
                        class: "table-thumbnail table-thumbnail--person table-thumbnail--small" %>
                <% else %>
                  <span class="table-thumbnail-icon table-thumbnail-icon--person table-thumbnail-icon--small">
                    <%= lucide_icon("user", size: 14) %>
                  </span>
                <% end %>
                <%= person.user.first_name %> <%= person.user.last_name %>
              </span>
            </td>
            <td class="text-right" data-testid="person-classification-cell">
              <%= lucide_icon classification_icon(person.classification),
                    size: 16,
                    class: classification_icon_class(person.classification),
                    title: person.classification.humanize,
                    data: { testid: "person-classification-icon" } %>
            </td>
            <% if authenticated? %>
              <td class="data-table__icon-cell text-right" data-testid="person-mute-cell">
                <% if @muted_person_ids.include?(person.id) %>
                  <%= button_to unmute_person_path(person),
                        method: :delete,
                        class: "icon-button",
                        title: "Unmute #{person.full_name}",
                        data: { testid: "unmute-person-#{person.id}", turbo: false } do %>
                    <%= lucide_icon("bell-off", size: 18) %>
                  <% end %>
                <% else %>
                  <%= button_to mute_person_path(person),
                        method: :post,
                        class: "icon-button",
                        title: "Mute #{person.full_name}",
                        data: { testid: "mute-person-#{person.id}", turbo: false } do %>
                    <%= lucide_icon("bell", size: 18) %>
                  <% end %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No people found.</p>
  </div>
<% end %>

