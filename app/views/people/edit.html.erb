<%# app/views/people/edit.html.erb %>
<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title" data-testid="person-name"><%= @person.full_name %></h1>
  </div>
</div>

<%= form_with model: @person, class: "resource-form" do |f| %>
  <% if @person.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p><%= pluralize(@person.errors.count, "error") %> prevented this person from being saved:</p>
      <ul>
        <% @person.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Main panel — name + image + description %>
  <div class="show-panel" data-testid="edit-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Name</h2>
      <div class="show-meta-row">
        <div class="show-meta-cell">
          <h3 class="show-meta-cell__label">First Name</h3>
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :first_name, class: "sr-only" %>
            <%= f.text_field :first_name,
                  class: "form-control #{'form-control--error' if @person.errors[:first_name].any?}",
                  data: { testid: "first-name-field" } %>
            <% if @person.errors[:first_name].any? %>
              <span class="field-error" data-testid="field-error">
                <%= @person.errors[:first_name].first %>
              </span>
            <% end %>
          </div>
        </div>
        <div class="show-meta-cell">
          <h3 class="show-meta-cell__label">Middle Name</h3>
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :middle_name, class: "sr-only" %>
            <%= f.text_field :middle_name,
                  class: "form-control",
                  data: { testid: "middle-name-field" } %>
          </div>
        </div>
        <div class="show-meta-cell">
          <h3 class="show-meta-cell__label">Last Name</h3>
          <div class="form-group" style="margin-bottom: 0;">
            <%= f.label :last_name, class: "sr-only" %>
            <%= f.text_field :last_name,
                  class: "form-control",
                  data: { testid: "last-name-field" } %>
          </div>
        </div>
      </div>
    </div>

    <div class="show-panel__section">
      <% if @person.image.attached? %>
        <div class="event-image">
          <%= image_tag @person.image.variant(:thumbnail),
                alt: @person.full_name,
                class: "event-image__thumbnail" %>
        </div>
        <p class="form-hint">Upload a new file to replace the current image.</p>
      <% end %>
      <div class="form-group">
        <%= f.label :image, "Person image" %>
        <%= f.file_field :image,
              accept: "image/jpeg,image/png,image/webp",
              class: "form-control",
              data: { testid: "image-field" } %>
        <% if @person.errors[:image].any? %>
          <span class="field-error" data-testid="field-error">
            <%= @person.errors[:image].first %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="show-panel__section">
      <h2 class="show-panel__heading">Description</h2>
      <div class="form-group">
        <%= f.label :description, class: "sr-only" %>
        <%= f.text_area :description,
              class: "form-control",
              rows: 4,
              data: { testid: "description-field" } %>
      </div>
    </div>
  </div>

  <%# Metadata panel %>
  <div class="show-panel" data-testid="edit-panel-metadata">
    <div class="show-meta-row">
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Visibility</h3>
        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :classification, "Classification", class: "sr-only" %>
          <%= f.select :classification,
                [["Unrestricted — visible to everyone", "unrestricted"],
                 ["Contacts — visible to my contacts",  "contacts"],
                 ["Restricted — visible only to me",    "restricted"]],
                {},
                { class: "form-control", data: { testid: "classification-field" } } %>
        </div>
      </div>
    </div>
  </div>

  <%# Social Media panel %>
  <div class="show-panel" data-testid="edit-panel-social-media" data-controller="social-media-accounts">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Social Media Platforms</h2>

      <div data-social-media-accounts-target="container">
        <%= f.fields_for :person_social_media_accounts do |af| %>
          <div class="form-group form-group--inline"
                data-social-media-accounts-target="row"
                data-testid="social-media-account-row">
            <div style="flex: 1;">
              <%= af.label :social_media_platform_id, "Platform", class: "sr-only" %>
              <%= af.collection_select :social_media_platform_id,
                    SocialMediaPlatform.order("LOWER(name) ASC"), :id, :name,
                    { include_blank: "Select a platform" },
                    { class: "form-control", data: { testid: "social-media-platform-select" } } %>
              <% if af.object.errors[:social_media_platform_id].any? %>
                <span class="field-error" data-testid="field-error">
                  <%= af.object.errors[:social_media_platform_id].first %>
                </span>
              <% end %>
            </div>
            <div style="flex: 1;">
              <%= af.label :username, class: "sr-only" %>
              <%= af.text_field :username,
                    placeholder: "Username",
                    class: "form-control",
                    data: { testid: "social-media-username-field" } %>
              <% if af.object.errors[:username].any? %>
                <span class="field-error" data-testid="field-error">
                  <%= af.object.errors[:username].first %>
                </span>
              <% end %>
            </div>
            <%= af.check_box :_destroy, class: "sr-only",
                  data: { testid: "remove-social-media-account", action: "change->social-media-accounts#toggleRemoved" } %>
            <%= af.label :_destroy, class: "icon-button icon-button--danger", title: "Remove",
                  data: { testid: "remove-social-media-account-button" } do %>
              <%= lucide_icon("x-circle", size: 18) %>
            <% end %>
          </div>
        <% end %>
      </div>

      <template data-social-media-accounts-target="template">
        <%= f.fields_for :person_social_media_accounts, PersonSocialMediaAccount.new, child_index: "NEW_RECORD" do |af| %>
          <div class="form-group form-group--inline"
                data-social-media-accounts-target="row"
                data-testid="social-media-account-row">
            <div style="flex: 1;">
              <%= af.label :social_media_platform_id, "Platform", class: "sr-only" %>
              <%= af.collection_select :social_media_platform_id,
                    SocialMediaPlatform.order("LOWER(name) ASC"), :id, :name,
                    { include_blank: "Select a platform" },
                    { class: "form-control", data: { testid: "social-media-platform-select" } } %>
            </div>
            <div style="flex: 1;">
              <%= af.label :username, class: "sr-only" %>
              <%= af.text_field :username,
                    placeholder: "Username",
                    class: "form-control",
                    data: { testid: "social-media-username-field" } %>
            </div>
            <button type="button" class="icon-button icon-button--danger"
                  data-action="social-media-accounts#removeNewRow"
                  data-testid="remove-new-social-media-account">
              <%= lucide_icon("x-circle", size: 18) %>
            </button>
          </div>
        <% end %>
      </template>

      <button type="button" class="btn btn-secondary"
            data-action="social-media-accounts#add"
            data-testid="add-social-media-account">
        <%= lucide_icon("plus", size: 16) %> Add Social Media Platform
      </button>
    </div>
  </div>

  <%# Actions panel %>
  <div class="show-panel show-panel--actions" data-testid="edit-panel-actions">
    <%= link_to person_path(@person), class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary" data-testid="submit-button">
      <%= lucide_icon("save", size: 16) %> Update Person
    </button>
  </div>

  <%# Admin panel %>
  <%= render "shared/audit_info", record: @person, testid: "edit-panel-admin" %>
<% end %>
