<%# app/views/social_media_platforms/new.html.erb %>

<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">New Social Media Platform</h1>
  </div>
</div>

<%= form_with model: @social_media_platform, class: "resource-form" do |f| %>
  <% if @social_media_platform.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p><%= pluralize(@social_media_platform.errors.count, "error") %> prevented this social media platform from being saved:</p>
      <ul>
        <% @social_media_platform.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Main div — name + url + description %>
  <div class="show-panel" data-testid="new-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Name</h2>
      <div class="form-group">
        <%= f.label :name, class: "sr-only" %>
        <%= f.text_field :name,
              class: "form-control #{'form-control--error' if @social_media_platform.errors[:name].any?}",
              data: { testid: "name-field" } %>
        <% if @social_media_platform.errors[:name].any? %>
          <span class="field-error" data-testid="field-error">
            <%= @social_media_platform.errors[:name].first %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="show-panel__section">
      <h2 class="show-panel__heading">URL</h2>
      <div class="form-group">
        <%= f.label :url, "URL", class: "sr-only" %>
        <%= f.text_field :url,
              placeholder: "https://www.example.com/",
              class: "form-control #{'form-control--error' if @social_media_platform.errors[:url].any?}",
              data: { testid: "url-field" } %>
        <% if @social_media_platform.errors[:url].any? %>
          <span class="field-error" data-testid="field-error">
            <%= @social_media_platform.errors[:url].first %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="show-panel__section">
      <h2 class="show-panel__heading">Description</h2>
      <div class="form-group">
        <%= f.label :description, class: "sr-only" %>
        <%= f.text_area :description,
              class: "form-control",
              rows: 4,
              data: { testid: "description-field" } %>
      </div>
    </div>
  </div>

  <%# Metadata div — logo %>
  <div class="show-panel" data-testid="new-panel-metadata">
    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Logo</h3>
      <div class="form-group">
        <%= f.label :logo, class: "sr-only" %>
        <%= f.file_field :logo,
              accept: "image/jpeg,image/png,image/webp",
              class: "form-control #{'form-control--error' if @social_media_platform.errors[:logo].any?}",
              data: { testid: "logo-field" } %>
        <% if @social_media_platform.errors[:logo].any? %>
          <span class="field-error" data-testid="field-error">
            <%= @social_media_platform.errors[:logo].first %>
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="new-panel-actions">
    <%= link_to social_media_platforms_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> Create Social Media Platform
    </button>
  </div>
<% end %>
