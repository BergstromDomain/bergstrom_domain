<%# app/views/social_media_platforms/show.html.erb %>

<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title" data-testid="social-media-platform-name"><%= @social_media_platform.name %></h1>
  </div>
</div>

<%# Main div — logo + description %>
<div class="show-panel" data-testid="show-panel-main">
  <% if @social_media_platform.logo.attached? %>
    <div class="show-panel__section">
      <%= image_tag @social_media_platform.logo, alt: @social_media_platform.name, class: "event-image__full" %>
    </div>
  <% end %>

  <div class="show-panel__section">
    <h2 class="show-panel__heading">Description</h2>
    <p data-testid="social-media-platform-description">
      <%= @social_media_platform.description.presence || "—" %>
    </p>
  </div>
</div>

<%# Metadata div %>
<div class="show-panel" data-testid="show-panel-metadata">
  <div class="show-meta-row">
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Social Media Platform Name</h3>
      <p class="show-meta-cell__value" data-testid="social-media-platform-name-value">
        <%= @social_media_platform.name %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">URL</h3>
      <p class="show-meta-cell__value" data-testid="social-media-platform-url-value">
        <%= link_to @social_media_platform.url, @social_media_platform.url,
              target: "_blank", rel: "noopener noreferrer" %>
      </p>
    </div>
  </div>
</div>

<%# Actions div %>
<div class="show-panel show-panel--actions" data-testid="show-panel-actions">
  <%= link_to social_media_platforms_path, class: "btn btn-secondary" do %>
    <%= lucide_icon("arrow-left", size: 16) %> Back to Social Media Platforms
  <% end %>

  <% if @policy.can_update? %>
    <span class="btn-divider">|</span>
    <%= link_to edit_social_media_platform_path(@social_media_platform), class: "btn btn-secondary" do %>
      <%= lucide_icon("pencil", size: 16) %> Edit Social Media Platform
    <% end %>
  <% end %>

  <% if @policy.can_delete? %>
    <span class="btn-divider">|</span>
    <%= button_to social_media_platform_path(@social_media_platform),
          method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Delete #{@social_media_platform.name}? This cannot be undone." } do %>
      <%= lucide_icon("trash-2", size: 16) %> Delete Social Media Platform
    <% end %>
  <% end %>
</div>
