<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title" data-testid="language-name"><%= @language.name %></h1>
  </div>
</div>

<div class="page-content--half">
  <%# Main div — flag %>
  <div class="show-panel" data-testid="show-panel-main">
    <div class="show-panel__section">
      <%= render "shared/flag_badge", flag: @language.flag, badge: "book-open-check", large: true, testid: "language-flag" %>
    </div>
  </div>

  <%# Metadata div %>
  <div class="show-panel" data-testid="show-panel-metadata">
    <div class="show-meta-row">
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Language Name</h3>
        <p class="show-meta-cell__value" data-testid="language-name-value"><%= @language.name %></p>
      </div>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Code</h3>
        <p class="show-meta-cell__value" data-testid="language-code-value"><%= @language.code %></p>
      </div>
    </div>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="show-panel-actions">
    <%= link_to languages_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("arrow-left", size: 16) %> Back
    <% end %>

    <% if @policy.can_update? %>
      <span class="btn-divider">|</span>
      <%= link_to edit_language_path(@language), class: "btn btn-secondary" do %>
        <%= lucide_icon("pencil", size: 16) %> Edit Language
      <% end %>
    <% end %>

    <% if @policy.can_delete? %>
      <span class="btn-divider">|</span>
      <%= button_to language_path(@language),
            method: :delete,
            class: "btn btn-danger",
            data: { turbo_confirm: "Delete #{@language.name}? This cannot be undone." } do %>
        <%= lucide_icon("trash-2", size: 16) %> Delete Language
      <% end %>
    <% end %>
  </div>
</div>
