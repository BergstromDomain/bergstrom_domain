<%# Locals: panel ("new"/"edit"), submit_label, cancel_path %>
<%= form_with model: language, class: "resource-form" do |f| %>
  <% if language.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p><%= pluralize(language.errors.count, "error") %> prevented this language from being saved:</p>
      <ul>
        <% language.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Main div — name + flag preview %>
  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Name</h2>
      <div class="form-group">
        <%= f.label :name, class: "sr-only" %>
        <%= f.text_field :name,
              class: "form-control #{'form-control--error' if language.errors[:name].any?}",
              data: { testid: "name-field" } %>
        <% if language.errors[:name].any? %>
          <span class="field-error" data-testid="field-error"><%= language.errors[:name].first %></span>
        <% end %>
      </div>
    </div>

    <% if language.flag.present? && language.errors[:flag].none? %>
      <div class="show-panel__section" data-testid="flag-preview">
        <%= render "shared/flag_badge", flag: language.flag, badge: "book-open-check", large: true %>
      </div>
    <% end %>
  </div>

  <%# Metadata div %>
  <div class="show-panel" data-testid="<%= panel %>-panel-metadata">
    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Code</h3>
      <div class="form-group">
        <%= f.label :code, class: "sr-only" %>
        <%= f.text_field :code,
              placeholder: "e.g. sv",
              maxlength: 5,
              class: "form-control #{'form-control--error' if language.errors[:code].any?}",
              data: { testid: "code-field" } %>
        <% if language.errors[:code].any? %>
          <span class="field-error" data-testid="field-error"><%= language.errors[:code].first %></span>
        <% end %>
        <p class="form-hint">The two-letter ISO 639-1 code, e.g. sv for Swedish, en for English.</p>
      </div>
    </div>

    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Flag</h3>
      <div class="form-group">
        <%= f.label :flag, class: "sr-only" %>
        <%= f.text_field :flag,
              placeholder: "e.g. 🇸🇪",
              class: "form-control #{'form-control--error' if language.errors[:flag].any?}",
              data: { testid: "flag-field" } %>
        <% if language.errors[:flag].any? %>
          <span class="field-error" data-testid="field-error"><%= language.errors[:flag].first %></span>
        <% end %>
        <p class="form-hint">
          One emoji. Open the emoji picker with Win + . (Windows) or Ctrl + Cmd + Space (macOS).
        </p>
      </div>
    </div>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to cancel_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
