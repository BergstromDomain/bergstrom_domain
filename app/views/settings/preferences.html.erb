<div class="page-header" data-testid="preferences-page">
  <div class="page-header__top">
    <div class="page-header__title-group">
      <h1 class="page-title">Preferences</h1>
      <p class="page-subtitle">
        <%= lucide_icon "settings-2", size: 16 %>
        User Settings
      </p>
    </div>
  </div>
</div>

<%= form_with model: @user, url: preferences_settings_path, method: :patch, class: "resource-form", data: { turbo: false } do |f| %>

  <% if @user&.errors&.any? %>
    <div class="form-errors" data-testid="preferences-errors">
      <p><%= pluralize(@user.errors.count, "error") %> prevented your preferences from being saved:</p>
      <ul>
        <% @user.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="show-panel" data-testid="preferences-panel">
    <h2 class="show-panel__heading">Preferences</h2>

    <div class="show-panel__section">
      <div class="form-group">
        <h3 class="show-meta-cell__label">Start Page</h3>
        <%= f.label :start_page, "Start Page", class: "sr-only" %>
        <%= f.select :start_page,
              [ [ "Home", "home" ] ] + UserAppSetting.live_apps_by_display_name,
              { selected: @user.start_page.presence || "home" },
              { class: "form-control", data: { testid: "preferences-start-page-field" } } %>
      </div>
    </div>

    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Default Visibility</h3>
      <p class="form-hint">Which classifications to show by default when viewing records?</p>
      <%= hidden_field_tag "user[default_classifications][]", "" %>
      <% Person.classifications.keys.each do |classification| %>
        <div class="form-check">
          <%= check_box_tag "user[default_classifications][]",
                classification,
                @user.default_classifications.include?(classification),
                id: "default_classification_#{classification}",
                data: { testid: "preferences-default-classification-#{classification}" } %>
          <%= label_tag "default_classification_#{classification}", classification.humanize %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="show-panel show-panel--actions" data-testid="preferences-actions-panel">
    <%= link_to settings_path,
          class: "btn btn-secondary",
          data: { testid: "preferences-cancel" } do %>
      <%= lucide_icon "circle-x", size: 16 %>
      Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary-action" data-testid="preferences-submit">
      <%= lucide_icon "save", size: 16 %>
      Save Preferences
    </button>
  </div>

<% end %>
