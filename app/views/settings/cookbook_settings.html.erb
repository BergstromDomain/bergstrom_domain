<div class="page-header" data-testid="cookbook-settings-page">
  <div class="page-header__top">
    <div class="page-header__title-group">
      <h1 class="page-title">Cookbook Settings</h1>
      <p class="page-subtitle">
        <%= lucide_icon "chef-hat", size: 16 %>
        App Settings
      </p>
    </div>
  </div>
</div>

<%= form_with model: @user_app_setting, url: cookbook_settings_path, method: :patch, class: "resource-form", data: { turbo: false } do |f| %>

  <% if @user_app_setting.errors.any? %>
    <div class="form-errors" data-testid="cookbook-settings-errors">
      <p><%= pluralize(@user_app_setting.errors.count, "error") %> prevented your settings from being saved:</p>
      <ul>
        <% @user_app_setting.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="show-panel" data-testid="cookbook-settings-panel">
    <h2 class="show-panel__heading">Cookbook Settings</h2>

    <div class="show-panel__section">
      <div class="form-group">
        <h3 class="show-meta-cell__label">Start Page</h3>
        <%= f.label :start_page, "Start Page", class: "sr-only" %>
        <%# Choices are added as each Cookbook page is built — see
            Authentication#cookbook_start_page_url. %>
        <%= f.select :start_page,
              [
                [ "Cookbook",                    "" ],
                [ "Browse Recipes By Cuisine",   "browse_by_cuisine" ],
                [ "Browse Recipes By Food Type", "browse_by_food_type" ],
                [ "Filter Recipes",              "filter_recipes" ],
                [ "Cuisines",   "cuisines" ],
                [ "Food Types", "food_types" ],
                [ "Languages",  "languages" ]
              ],
              { selected: @user_app_setting.start_page },
              { class: "form-control", data: { testid: "cookbook-settings-start-page-field" } } %>
      </div>
    </div>

    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Default Classification</h3>
      <p class="form-hint">Which classification to use as default when creating recipes?</p>
      <div class="form-group">
        <%= f.label :default_classification, "Classification", class: "sr-only" %>
        <%= f.select :default_classification,
              [ [ "Unrestricted — visible to everyone", "unrestricted" ],
                [ "Contacts — visible to my contacts",  "contacts" ],
                [ "Restricted — visible only to me",    "restricted" ] ],
              {},
              { class: "form-control", data: { testid: "cookbook-settings-default-classification-field" } } %>
      </div>
    </div>

    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Default Language</h3>
      <p class="form-hint">Which language to use as default when creating recipes? English unless you choose another.</p>
      <div class="form-group">
        <% default_language = @user_app_setting.effective_default_language %>
        <%= f.label :default_language_id, "Default Language", class: "sr-only" %>
        <%= f.collection_select :default_language_id,
              Language.order("LOWER(name) ASC"), :id, :name,
              { selected: default_language&.id, include_blank: ("Select a Language" unless default_language) },
              { class: "form-control", data: { testid: "cookbook-settings-default-language-field" } } %>
      </div>
    </div>
  </div>

  <div class="show-panel show-panel--actions" data-testid="cookbook-settings-actions-panel">
    <%= link_to settings_path,
          class: "btn btn-secondary",
          data: { testid: "cookbook-settings-cancel" } do %>
      <%= lucide_icon "circle-x", size: 16 %>
      Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary-action" data-testid="cookbook-settings-submit">
      <%= lucide_icon "save", size: 16 %>
      Save Cookbook Settings
    </button>
  </div>

<% end %>
