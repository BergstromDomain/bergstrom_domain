<%# One ingredient list. Locals: sf (fields_for builder for an IngredientSection). %>
<div class="ingredient-section" data-recipe-ingredients-target="section" data-testid="ingredient-section" style="<%= 'display: none' if sf.object.marked_for_destruction? %>">
  <div class="ingredient-section__header">
    <%= sf.label :heading, "List Heading", class: "sr-only" %>
    <%= sf.text_field :heading,
          placeholder: "List heading (optional), e.g. Meat sauce",
          class: "form-control",
          data: { testid: "section-heading-field" } %>
    <% if sf.object.persisted? %>
      <%= sf.hidden_field :_destroy, value: sf.object.marked_for_destruction? ? "1" : "0", data: { recipe_ingredients_target: "destroy" } %>
    <% end %>
    <button type="button" class="btn btn-secondary ingredient-section__remove"
            data-action="recipe-ingredients#removeSection" data-testid="remove-section-button"
            aria-label="Remove this ingredient list">
      <%= lucide_icon("trash-2", size: 16) %> Remove List
    </button>
  </div>

  <div class="ingredient-row ingredient-row--labels" aria-hidden="true">
    <span>Quantity</span><span>Measurement</span><span>Ingredient</span><span>Comment</span><span></span>
  </div>

  <div data-recipe-ingredients-target="rows">
    <%= sf.fields_for :ingredients do |ingf| %>
      <%= render "ingredient_row", ingf: ingf %>
    <% end %>
  </div>

  <template data-recipe-ingredients-target="rowTemplate">
    <%= sf.fields_for :ingredients, Ingredient.new, child_index: "NEW_INGREDIENT" do |ingf| %>
      <%= render "ingredient_row", ingf: ingf %>
    <% end %>
  </template>

  <button type="button" class="btn btn-secondary"
          data-action="recipe-ingredients#addIngredient" data-testid="add-ingredient-button">
    <%= lucide_icon("plus", size: 16) %> Add Ingredient
  </button>
</div>
