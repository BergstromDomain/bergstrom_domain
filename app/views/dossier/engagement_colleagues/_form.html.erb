<%# Locals: colleague, panel ("new"/"edit"), submit_label %>
<% engagement = colleague.engagement %>
<% url = colleague.persisted? ? dossier_engagement_colleague_path(engagement, colleague) : dossier_engagement_colleagues_path(engagement) %>
<%= form_with model: colleague, url: url, class: "resource-form" do |f| %>
  <%= render "dossier/shared/contact_errors", record: colleague, noun: "colleague" %>

  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <p class="form-hint">During <%= link_to engagement.to_toast_label, dossier_engagement_path(engagement) %>,
      on no Assignment you shared. Only you and Admins see Colleagues, and they're never on a CV.</p>
    <%= render "dossier/shared/contact_fields", f: f, record: colleague,
          change_path: (new_dossier_engagement_colleague_path(engagement) if colleague.new_record?) %>
  </div>

  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to dossier_engagement_path(engagement, anchor: "colleagues"), class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
