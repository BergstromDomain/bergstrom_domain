<%# Locals: record, panel ("new"/"edit"), submit_label, cancel_path %>
<%= form_with model: record, class: "resource-form" do |f| %>
  <% if record.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p><%= pluralize(record.errors.count, "error") %> prevented this <%= singular_name.downcase %> from being saved:</p>
      <ul>
        <% record.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <%= render "fields", f: f, record: record %>
    <%= render "dossier/reference_data/field", f: f, record: record, attribute: :description,
          label: "Description", text_area: true %>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to cancel_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
