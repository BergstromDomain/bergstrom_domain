<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Merge <%= @record.name %></h1>
  </div>
</div>

<%= form_with url: merge_dossier_skill_path(@record), method: :post, class: "resource-form" do |f| %>
  <div class="show-panel" data-testid="merge-panel">
    <div class="show-panel__section">
      <div class="form-group">
        <%= f.label :target_id, "Merge Into", class: "show-panel__heading" %>
        <%= f.select :target_id, @targets.map { |skill| [ skill.name, skill.id ] },
              { include_blank: "Choose the Skill to keep", selected: params[:target_id] },
              class: "form-control #{'form-control--error' if @error}", data: { testid: "merge-target-field" } %>
        <% if @error %>
          <span class="field-error" data-testid="field-error"><%= @error %></span>
        <% end %>
        <p class="form-hint">
          Every Tech Stack and Achievement using <%= @record.name %> moves to the Skill you keep.
          <%= @record.name %><%= " and its aliases" if @record.aliases.any? %> become aliases of it,
          and <%= @record.name %> is deleted.
        </p>
      </div>
    </div>
  </div>

  <div class="show-panel show-panel--actions" data-testid="merge-panel-actions">
    <%= link_to dossier_skill_path(@record), class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary"
            data-turbo-confirm="Merge <%= @record.name %> into the chosen Skill? <%= @record.name %> will be deleted.">
      <%= lucide_icon("merge", size: 16) %> Merge Skill
    </button>
  </div>
<% end %>
