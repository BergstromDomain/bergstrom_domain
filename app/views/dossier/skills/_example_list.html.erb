<%# A Soft Skill's examples: Achievements (with Situation, Impact and Assignment), then Contributions. Locals: achievements, contributions %>
<ul class="dossier-skill-examples">
  <% achievements.each do |achievement| %>
    <li class="dossier-skill-example" data-testid="skill-example">
      <p class="dossier-skill-example__text"><%= link_to achievement.text, dossier_achievement_path(achievement) %></p>
      <% if achievement.situation_visible_to?(current_user) %>
        <p data-testid="skill-example-situation"><strong>Situation:</strong> <%= achievement.situation %></p>
      <% end %>
      <% if achievement.impact %>
        <p data-testid="skill-example-impact"><strong>Impact:</strong> <%= achievement.impact %></p>
      <% end %>
      <p class="form-hint">
        <%= link_to achievement.assignment.to_toast_label, dossier_assignment_path(achievement.assignment) %>,
        <%= achievement.assignment.date_range %>
      </p>
    </li>
  <% end %>
  <% contributions.each do |contribution| %>
    <li class="dossier-skill-example" data-testid="skill-example-contribution">
      <p class="dossier-skill-example__text"><%= link_to contribution.title, dossier_contribution_path(contribution) %></p>
      <p class="form-hint">
        <%= safe_join([ contribution.kind_label,
                        (link_to(contribution.event.name, dossier_organisation_path(contribution.event)) if contribution.event),
                        contribution.date ].compact, ", ") %>
      </p>
    </li>
  <% end %>
</ul>
