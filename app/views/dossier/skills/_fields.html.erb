<%= render "dossier/shared/field", f: f, record: record, attribute: :name, label: "Name" %>
<%= render "dossier/shared/field", f: f, record: record, attribute: :skill_category_id, label: "Skill Category",
      error_attribute: :skill_category,
      field: f.collection_select(:skill_category_id, Dossier::SkillCategory.in_tree_order, :id, :full_name,
                                 { include_blank: "Choose a Skill Category" }, class: "form-control",
                                 data: { testid: "skill-category-field" }) %>
<%= render "dossier/shared/field", f: f, record: record, attribute: :vendor_id, label: "Vendor",
      error_attribute: :vendor, hint: "Optional: the Organisation that makes it, e.g. Microsoft for Project.",
      field: f.collection_select(:vendor_id, Dossier::Organisation.alphabetical, :id, :name,
                                 { include_blank: "No Vendor" }, class: "form-control",
                                 data: { testid: "skill-vendor-field" }) %>
<%= render "dossier/shared/field", f: f, record: record, attribute: :show_vendor_in_name, label: "Show Vendor In Name",
      hint: "Shows the vendor's abbreviation (or name) first: Microsoft Project, AWS S3.",
      field: f.check_box(:show_vendor_in_name, data: { testid: "skill-show-vendor-field" }) %>
<%= render "dossier/shared/field", f: f, record: record, attribute: :aliases_text, label: "Aliases",
      error_attribute: :aliases, hint: "Other spellings of this Skill, separated by commas." %>
<%= render "dossier/shared/field", f: f, record: record, attribute: :parent_id, label: "Version Of",
      error_attribute: :parent, hint: "Optional: e.g. Windows for Windows XP. A CV then shows the family as Windows (XP, Vista).",
      field: f.collection_select(:parent_id, Dossier::Skill.where(parent_id: nil).where.not(id: record.id).alphabetical,
                                 :id, :name, { include_blank: "Not a version" }, class: "form-control",
                                 data: { testid: "skill-parent-field" }) %>
