<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Skills</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Every Skill in your Tech Stacks and Achievements, with your years of experience, most first. Personal projects are counted separately; Training is listed but doesn't add to your years.
  </p>
</div>

<% if @groups.any? %>
  <% @groups.each do |category, subgroups| %>
    <details class="show-panel dossier-skill-group" open data-testid="my-skills-category">
      <summary class="dossier-skill-group__summary" data-testid="my-skills-toggle-<%= category.id %>">
        <h2 class="show-panel__heading"><%= category.name %></h2>
        <span class="dossier-skill-group__count"><%= pluralize(subgroups.sum { |_, list| list.size }, "Skill") %></span>
      </summary>
      <div class="show-panel__section">
        <div class="data-table-wrapper">
          <table class="data-table dossier-skill-table">
            <thead>
              <tr>
                <th>Skill</th>
                <th>Years</th>
                <th>Personal</th>
                <th>Last Used</th>
                <th class="text-center">Assignments</th>
                <th class="text-center">Training</th>
              </tr>
            </thead>
            <% subgroups.each do |subcategory, experiences| %>
            <tbody>
              <% if subcategory %>
                <tr class="data-table__group">
                  <th colspan="6" data-testid="my-skills-subcategory"><%= subcategory.name %></th>
                </tr>
              <% end %>
              <% experiences.each do |experience| %>
                <tr data-testid="my-skill-row">
                  <td><%= link_to experience.skill.display_name, dossier_skill_path(experience.skill), class: "data-table__name-link" %></td>
                  <td data-testid="my-skill-years"><%= experience.duration || "—" %></td>
                  <td data-testid="my-skill-personal"><%= experience.personal_duration || "—" %></td>
                  <td><%= experience.last_used %></td>
                  <td class="text-center"><%= experience.assignments.size %></td>
                  <td class="text-center" data-testid="my-skill-training"><%= experience.training.size %></td>
                </tr>
              <% end %>
            </tbody>
            <% end %>
          </table>
        </div>
      </div>
    </details>
  <% end %>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No Skills yet. They come from your Assignments' Tech Stacks, your Achievements' Skills and your Training.</p>
  </div>
<% end %>
