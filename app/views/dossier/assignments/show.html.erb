<% policy = Policy.new(current_user, @assignment) %>
<% private_details = @assignment.private_details_visible_to?(current_user) %>
<% tech_stack = Dossier::AssignmentTechStack.new(@assignment) %>
<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title"><%= @assignment.title %></h1>
  </div>
</div>

<%# Summary div — about the client, the project and what was tested %>
<div class="show-panel dossier-assignment-summary" data-testid="assignment-summary-panel">
  <div class="show-panel__section">
    <h2 class="show-panel__heading">Summary</h2>
    <% if @assignment.client.description.present? %>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Client Description</h3>
        <p class="show-meta-cell__value" data-testid="assignment-client-description"><%= @assignment.client.description %></p>
      </div>
    <% end %>
    <% if @assignment.summary %>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Project Description</h3>
        <p class="show-meta-cell__value" data-testid="assignment-summary"><%= @assignment.summary %></p>
      </div>
    <% end %>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">System Under Test</h3>
      <p class="show-meta-cell__value" data-testid="assignment-systems-under-test">
        <% if @assignment.systems_under_test_na %>
          N/A
        <% else %>
          <%= skill_family_links(tech_stack.systems_under_test) %>
        <% end %>
      </p>
    </div>
    <%# Vendors and Customers are private: the owner and Admins only. %>
    <% partners = private_details ? [ [ "Vendor", "vendors", @assignment.vendors ], [ "Customer", "customers", @assignment.customers ] ].select { |*, list| list.any? } : [] %>
    <% if partners.any? %>
      <div class="show-meta-row">
        <% partners.each do |label, key, list| %>
          <div class="show-meta-cell">
            <h3 class="show-meta-cell__label"><%= label %></h3>
            <p class="show-meta-cell__value" data-testid="assignment-<%= key %>">
              <span><%= safe_join(list.map { |partner| link_to(partner.organisation.name, dossier_organisation_path(partner.organisation)) }, ", ") %></span>
            </p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# Metadata div %>
<div class="show-panel" data-testid="show-panel-metadata">
  <div class="show-meta-row">
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Client</h3>
      <p class="show-meta-cell__value" data-testid="assignment-client"><%= link_to @assignment.client.label, dossier_organisation_path(@assignment.client) %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Project</h3>
      <p class="show-meta-cell__value" data-testid="assignment-project"><%= @assignment.project || "—" %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Role</h3>
      <p class="show-meta-cell__value" data-testid="assignment-role">
        <%= @assignment.role ? link_to(@assignment.role_name, dossier_role_path(@assignment.role)) : @assignment.role_name %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Dates</h3>
      <p class="show-meta-cell__value" data-testid="assignment-dates"><%= @assignment.date_range %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Location</h3>
      <p class="show-meta-cell__value" data-testid="assignment-location">
        <% if @assignment.location %>
          <%= link_to @assignment.location.name, dossier_location_path(@assignment.location) %><%= " (remote)" if @assignment.remote? %>
        <% else %>
          <%= @assignment.remote? ? "(remote)" : "—" %>
        <% end %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Engagement</h3>
      <p class="show-meta-cell__value" data-testid="assignment-engagement">
        <%= link_to @assignment.engagement.to_toast_label, dossier_engagement_path(@assignment.engagement) %>
      </p>
    </div>
  </div>
</div>

<%# Achievements div — the CV bullet points, in order %>
<div class="show-panel" id="achievements" data-testid="assignment-achievements">
  <div class="show-panel__section">
    <h2 class="show-panel__heading">Achievements</h2>
    <% achievements = @assignment.achievements %>
    <% if achievements.any? %>
      <%= render "dossier/achievements/table", achievements: achievements, sortable: policy.can_update? %>
    <% else %>
      <p data-testid="achievements-empty">No Achievements yet.</p>
    <% end %>
  </div>
</div>

<%# Tech Stack div — a table per Skill Category, in position order; System Under Test is in the Summary %>
<% blocks = tech_stack.blocks %>
<% if blocks.any? %>
  <div class="show-panel" data-testid="tech-stack">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Tech Stack</h2>
      <% blocks.each do |block| %>
        <%# The category labels the row; sub-category headings sit above their Skills. %>
        <% headed = block.columns.any?(&:heading) %>
        <div class="data-table-wrapper dossier-tech-stack-block" data-testid="tech-stack-block">
          <table class="data-table dossier-tech-stack-table">
            <tbody>
              <tr>
                <th scope="row" class="dossier-tech-stack-table__category" <%= "rowspan=2" if headed %>><%= block.category.name %></th>
                <% if headed %>
                  <% block.columns.each do |column| %>
                    <th scope="col" class="dossier-tech-stack-table__heading"><%= column.heading || "General" %></th>
                  <% end %>
                <% else %>
                  <td><%= skill_family_links(block.columns.first.families) %></td>
                <% end %>
              </tr>
              <% if headed %>
                <tr>
                  <% block.columns.each do |column| %>
                    <td><%= skill_family_links(column.families) %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# Training div %>
<%= render "dossier/credentials/panel", credentials: @assignment.credentials.training.newest_first.includes(:provider, credential_skills: :skill) %>

<% if private_details %>
  <%= render "colleagues", assignment: @assignment, editable: policy.can_update? %>
<% end %>

<%# Actions div %>
<div class="show-panel show-panel--actions" data-testid="show-panel-actions">
  <%= link_to dossier_engagement_path(@assignment.engagement), class: "btn btn-secondary" do %>
    <%= lucide_icon("arrow-left", size: 16) %> Back
  <% end %>

  <% if policy.can_update? %>
    <span class="btn-divider">|</span>
    <%= link_to new_dossier_achievement_path(assignment_id: @assignment.id), class: "btn btn-primary-action" do %>
      <%= lucide_icon("plus", size: 16) %> Add Achievement
    <% end %>
    <span class="btn-divider">|</span>
    <%= link_to new_dossier_credential_path(assignment_id: @assignment.id), class: "btn btn-primary-action" do %>
      <%= lucide_icon("graduation-cap", size: 16) %> Add Training
    <% end %>
    <span class="btn-divider">|</span>
    <%= link_to edit_dossier_assignment_path(@assignment), class: "btn btn-secondary" do %>
      <%= lucide_icon("pencil", size: 16) %> Edit Assignment
    <% end %>
  <% end %>

  <% if policy.can_delete? %>
    <span class="btn-divider">|</span>
    <%= button_to dossier_assignment_path(@assignment),
          method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Delete #{@assignment.to_toast_label} and its Achievements? You can restore them for 30 days." } do %>
      <%= lucide_icon("trash-2", size: 16) %> Delete Assignment
    <% end %>
  <% end %>
</div>
