<% policy = Policy.new(current_user, @assignment) %>
<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title"><%= @assignment.to_toast_label %></h1>
  </div>
</div>

<%# Main div — summary %>
<% if @assignment.summary %>
  <div class="show-panel" data-testid="show-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Summary</h2>
      <p data-testid="assignment-summary"><%= @assignment.summary %></p>
    </div>
  </div>
<% end %>

<%# Metadata div %>
<div class="show-panel" data-testid="show-panel-metadata">
  <div class="show-meta-row">
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Client</h3>
      <p class="show-meta-cell__value" data-testid="assignment-client"><%= link_to @assignment.client.label, dossier_organisation_path(@assignment.client) %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Project</h3>
      <p class="show-meta-cell__value" data-testid="assignment-project"><%= @assignment.project || "—" %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Role</h3>
      <p class="show-meta-cell__value" data-testid="assignment-role">
        <%= @assignment.role ? link_to(@assignment.role_name, dossier_role_path(@assignment.role)) : @assignment.role_name %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Dates</h3>
      <p class="show-meta-cell__value" data-testid="assignment-dates"><%= @assignment.date_range %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Location</h3>
      <p class="show-meta-cell__value" data-testid="assignment-location">
        <% if @assignment.location %>
          <%= link_to @assignment.location.name, dossier_location_path(@assignment.location) %><%= " (remote)" if @assignment.remote? %>
        <% else %>
          <%= @assignment.remote? ? "(remote)" : "—" %>
        <% end %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Engagement</h3>
      <p class="show-meta-cell__value" data-testid="assignment-engagement">
        <%= link_to @assignment.engagement.to_toast_label, dossier_engagement_path(@assignment.engagement) %>
      </p>
    </div>
  </div>
</div>

<%# Tech Stack div %>
<div class="show-panel" data-testid="tech-stack">
  <div class="show-panel__section">
    <h2 class="show-panel__heading">Tech Stack</h2>
  </div>
  <div class="show-meta-row">
    <% Dossier::TechStack::SLOTS.each do |slot, plural| %>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label"><%= Dossier::TechStack::LABELS.fetch(plural) %></h3>
        <p class="show-meta-cell__value" data-testid="tech-stack-<%= plural.to_s.dasherize %>">
          <% if @assignment.public_send(:"#{plural}_na") %>
            N/A
          <% else %>
            <%# One span: the cell is a flex row, whose gap would land before each comma. %>
            <span><%= safe_join(@assignment.skills_in(slot).map { |skill| link_to(skill.name, dossier_skill_path(skill)) }, ", ") %></span>
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>

<%# Achievements div — the CV bullet points, in order %>
<div class="show-panel" id="achievements" data-testid="assignment-achievements">
  <div class="show-panel__section">
    <h2 class="show-panel__heading">Achievements</h2>
    <% achievements = @assignment.achievements %>
    <% if achievements.any? %>
      <%= render "dossier/achievements/table", achievements: achievements, sortable: policy.can_update? %>
    <% else %>
      <p data-testid="achievements-empty">No Achievements yet.</p>
    <% end %>
  </div>
</div>

<%# Actions div %>
<div class="show-panel show-panel--actions" data-testid="show-panel-actions">
  <%= link_to dossier_engagement_path(@assignment.engagement), class: "btn btn-secondary" do %>
    <%= lucide_icon("arrow-left", size: 16) %> Back
  <% end %>

  <% if policy.can_update? %>
    <span class="btn-divider">|</span>
    <%= link_to new_dossier_achievement_path(assignment_id: @assignment.id), class: "btn btn-primary-action" do %>
      <%= lucide_icon("plus", size: 16) %> Add Achievement
    <% end %>
    <span class="btn-divider">|</span>
    <%= link_to edit_dossier_assignment_path(@assignment), class: "btn btn-secondary" do %>
      <%= lucide_icon("pencil", size: 16) %> Edit Assignment
    <% end %>
  <% end %>

  <% if policy.can_delete? %>
    <span class="btn-divider">|</span>
    <%= button_to dossier_assignment_path(@assignment),
          method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Delete #{@assignment.to_toast_label}? This cannot be undone." } do %>
      <%= lucide_icon("trash-2", size: 16) %> Delete Assignment
    <% end %>
  <% end %>
</div>
