<%# Locals: assignment %>
<li class="dossier-assignment-row" data-testid="assignment-row">
  <span>
    <%= link_to assignment.to_toast_label, dossier_assignment_path(assignment), class: "data-table__name-link" %>
    <% if assignment.tech_stack_blank? %>
      <span class="badge badge--pending" data-testid="tech-stack-incomplete"
            title="Every Tech Stack list is N/A and there's no System Under Test">Tech Stack Incomplete</span>
    <% end %>
  </span>
  <span class="dossier-assignment-row__dates"><%= assignment.date_range %></span>
</li>
