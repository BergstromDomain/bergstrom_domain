<%# Locals: assignment; logo (optional, true to lead with the client's logo) %>
<li class="dossier-assignment-row" data-testid="assignment-row">
  <span class="dossier-assignment-row__name">
    <% if local_assigns[:logo] %><%= organisation_logo(assignment.client, size: :small) %><% end %>
    <%= link_to assignment.heading, dossier_assignment_path(assignment), class: "data-table__name-link" %>
    <% if assignment.tech_stack_blank? %>
      <span class="badge badge--pending" data-testid="tech-stack-incomplete"
            title="Every Tech Stack list is N/A">Tech Stack Incomplete</span>
    <% end %>
  </span>
  <span class="dossier-assignment-row__dates"><%= assignment.date_range %></span>
</li>
