<%# Locals: assignment; logo (optional, true to lead with the client's logo); moves (optional, { first:, last: } for Up/Down) %>
<li class="dossier-assignment-row" data-testid="assignment-row">
  <span class="dossier-assignment-row__name">
    <% if local_assigns[:logo] %><%= organisation_logo(assignment.client, size: :small) %><% end %>
    <%= link_to assignment.heading, dossier_assignment_path(assignment), class: "data-table__name-link" %>
    <% if assignment.tech_stack_blank? %>
      <span class="badge badge--pending" data-testid="tech-stack-incomplete"
            title="Every Tech Stack list is N/A">Tech Stack Incomplete</span>
    <% end %>
  </span>
  <span class="dossier-assignment-row__end">
    <span class="dossier-assignment-row__dates"><%= assignment.date_range %></span>
    <% if (moves = local_assigns[:moves]) %>
      <span class="dossier-achievement__moves">
        <%= button_to move_dossier_assignment_path(assignment, direction: "up"), method: :patch,
              class: "icon-button", title: "Move up", disabled: moves[:first],
              data: { testid: "assignment-move-up" } do %>
          <%= lucide_icon("arrow-up", size: 16) %>
        <% end %>
        <%= button_to move_dossier_assignment_path(assignment, direction: "down"), method: :patch,
              class: "icon-button", title: "Move down", disabled: moves[:last],
              data: { testid: "assignment-move-down" } do %>
          <%= lucide_icon("arrow-down", size: 16) %>
        <% end %>
      </span>
    <% end %>
  </span>
</li>
