<%# Locals: assignment, panel ("new"/"edit"), submit_label, cancel_path %>
<%= form_with model: assignment, class: "resource-form resource-form--wide" do |f| %>
  <%= render "dossier/shared/form_errors", record: assignment, noun: "assignment" %>

  <%# Main div — where the work was done %>
  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <% if assignment.new_record? %>
      <%= render "dossier/shared/field", f: f, record: assignment, attribute: :engagement_id, label: "Engagement",
            error_attribute: :engagement,
            field: f.collection_select(:engagement_id, engagement_choices, :id, :to_toast_label,
                                       { include_blank: "Choose an Engagement" }, class: "form-control",
                                       data: { testid: "engagement-field" }) %>
    <% end %>
    <%= render "dossier/shared/field", f: f, record: assignment, attribute: :client_id, label: "Client",
          error_attribute: :client,
          field: f.collection_select(:client_id, Dossier::Organisation.alphabetical, :id, :name,
                                     { include_blank: "Choose the client" }, class: "form-control",
                                     data: { testid: "client-field" }),
          hint: safe_join([ "Where the work was done. Not listed? ",
                            link_to("Add An Organisation", new_dossier_organisation_path, target: "_blank", rel: "noopener"),
                            " in a new tab, then reload this page." ]) %>
    <%= render "dossier/shared/field", f: f, record: assignment, attribute: :role_id, label: "Role",
          field: f.collection_select(:role_id, Dossier::Role.alphabetical, :id, :name,
                                     { include_blank: "Same as position title" }, class: "form-control",
                                     data: { testid: "role-field" }),
          hint: "What you did for the client." %>
    <%= render "dossier/shared/field", f: f, record: assignment, attribute: :project, label: "Project",
          hint: "Optional — tells several Assignments for one client apart on the Timeline." %>
  </div>

  <%# Dates div %>
  <div class="show-panel" data-testid="<%= panel %>-panel-dates">
    <%= render "dossier/shared/date_fields", f: f, record: assignment, edge: :start, label: "Start",
          hint: "Must fall within the Engagement's dates." %>
    <%= render "dossier/shared/date_fields", f: f, record: assignment, edge: :end, label: "End",
          hint: "Leave empty if it's still running." %>
  </div>

  <%# Place div %>
  <div class="show-panel" data-testid="<%= panel %>-panel-place">
    <%= render "dossier/shared/field", f: f, record: assignment, attribute: :location_id, label: "Location",
          field: f.collection_select(:location_id, Dossier::Location.alphabetical, :id, :name,
                                     { include_blank: "None" }, class: "form-control", data: { testid: "location-field" }) %>
    <%= render "dossier/shared/field", f: f, record: assignment, attribute: :remote, label: "Remote",
          field: f.check_box(:remote, data: { testid: "remote-field" }) %>
    <%= render "dossier/shared/field", f: f, record: assignment, attribute: :summary, label: "Summary", text_area: true,
          hint: "Optional, terse form." %>
  </div>

  <%# Tech Stack div — every list filled or N/A %>
  <div class="show-panel" data-testid="<%= panel %>-panel-tech-stack">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Tech Stack</h2>
      <p class="form-hint">
        Every list needs at least one item, or N/A. Separate items with commas; new names become
        Skills in the Uncategorised Skill Category.
      </p>
    </div>
    <%= render "dossier/shared/field", f: f, record: assignment, attribute: :system_under_test, label: "System Under Test",
          hint: "What was tested, e.g. Salesforce CRM replacing the legacy system. N/A if unknown." %>
    <% Dossier::TechStack::LABELS.each do |plural, label| %>
      <% errors = assignment.errors[:"#{plural}_text"] %>
      <div class="show-panel__section">
        <div class="form-group">
          <%= f.label :"#{plural}_text", label, class: "show-panel__heading" %>
          <%= f.text_field :"#{plural}_text",
                class: "form-control #{'form-control--error' if errors.any?}",
                data: { testid: "#{plural.to_s.dasherize}-field" } %>
          <label class="form-check">
            <%= f.check_box :"#{plural}_na", data: { testid: "#{plural.to_s.dasherize}-na-field" } %> N/A
          </label>
          <% if errors.any? %>
            <span class="field-error" data-testid="field-error"><%= errors.first %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to cancel_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
