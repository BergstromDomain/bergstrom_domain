<%# Locals: credential, panel ("new"/"edit"), submit_label, cancel_path %>
<%= form_with model: credential, class: "resource-form resource-form--wide", multipart: true do |f| %>
  <%= render "dossier/shared/form_errors", record: credential, noun: "credential" %>

  <%# Description div — what it is and covered, with the certificates (as on its page) %>
  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <h2 class="show-panel__heading">Description</h2>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :title, label: "Title",
          hint: "e.g. \"Excel VBA Essential Training\" or \"Certified ScrumMaster\"." %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :description, label: "Description", text_area: true,
          hint: "Optional: what it covered, e.g. a degree's major and thesis, or a course's topics." %>
    <% saved = credential.persisted? ? ActiveStorage::Attachment.where(record: credential, name: "files").includes(:blob).order(:id) : [] %>
    <% if saved.any? %>
      <div class="show-panel__section">
        <h2 class="show-panel__heading">Saved Certificates</h2>
        <% kept = credential.files.map(&:blob_id) %>
        <%# A blank entry so unticking every file still removes them all. %>
        <%= hidden_field_tag "dossier_credential[files][]", "", id: nil %>
        <% saved.each do |file| %>
          <div class="form-group" data-testid="saved-certificate">
            <%= check_box_tag "dossier_credential[files][]", file.signed_id, kept.include?(file.blob_id), id: "keep_file_#{file.id}" %>
            <%= label_tag "keep_file_#{file.id}", "Keep #{file.filename}" %>
          </div>
        <% end %>
        <p class="form-hint">Untick a file to remove it when you save.</p>
      </div>
    <% end %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :files, label: "Certificates",
          field: f.file_field(:files, multiple: true, accept: Dossier::Credential::FILE_TYPES.join(","),
                              class: "form-control", data: { testid: "files-field" }),
          hint: "Optional: PDF, JPEG or PNG scans of the certificate, up to 10 MB each. Only you and admins can open them." %>
  </div>

  <%# Details div — in the page's order %>
  <div class="show-panel" data-testid="<%= panel %>-panel-details">
    <h2 class="show-panel__heading">Details</h2>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :credential_type_id, label: "Type",
          error_attribute: :credential_type,
          field: f.collection_select(:credential_type_id, Dossier::CredentialType.in_order, :id, :name,
                                     { include_blank: "Choose a type" }, class: "form-control",
                                     data: { testid: "credential-type-field" }),
          hint: "Degree, Certification, Course… Course and other training types also show in the Training panels." %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :status, label: "Status",
          field: f.select(:status, Dossier::Credential::STATUS_LABELS.invert, { include_blank: "From the dates" },
                          class: "form-control", data: { testid: "status-field" }),
          hint: "To Do: not started yet (Started may be empty). In Progress: no Completed date yet. Completed: needs a Completed date. Left as \"From the dates\", it's Completed when there's a Completed date. Only Completed courses show on the Credentials page and a CV skips To Do." %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :provider_id, label: "Issued By",
          error_attribute: :provider,
          field: f.collection_select(:provider_id, Dossier::Organisation.alphabetical, :id, :name,
                                     { include_blank: "Choose the issuer (optional)" }, class: "form-control",
                                     data: { testid: "provider-field" }),
          hint: safe_join([ "Who ran the course or issued it, e.g. LinkedIn Learning, a university, or your employer for an in-house course. Not listed? ",
                            link_to("Add An Organisation", new_dossier_organisation_path, target: "_blank", rel: "noopener"),
                            " in a new tab, then reload this page." ]) %>
    <%= render "dossier/shared/date_fields", f: f, record: credential, edge: :start, label: "Started",
          hint: "Add the month and day only if you know them; a year on its own is fine. For a one-day course, give the same date for Started and Completed." %>
    <%= render "dossier/shared/date_fields", f: f, record: credential, edge: :end, label: "Completed",
          hint: "When you finished it or it was awarded. Leave empty while you're still taking it." %>
    <%= render "dossier/shared/date_fields", f: f, record: credential, edge: :expires, label: "Expires",
          hint: "Optional, for a certification that needs renewing. After a renewal, update this date and note the renewal in the description." %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :hours, label: "Hours",
          field: f.number_field(:hours, step: 0.5, min: 0, class: "form-control", data: { testid: "hours-field" }),
          hint: "Optional, e.g. 2.5." %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :engagement_id, label: "Engagement",
          error_attribute: :engagement,
          field: f.select(:engagement_id, engagement_choices.map { |e| [ "#{e.to_toast_label} (#{e.date_range})", e.id ] },
                          { include_blank: "None" }, class: "form-control", data: { testid: "engagement-field" }),
          hint: "Optional: the Engagement you took it during, e.g. your Personal Projects for a hobby course. None for a course on the bench or between jobs, or a degree." %>
    <% choices = assignment_choices.group_by(&:engagement).to_h do |engagement, assignments|
         [ engagement.to_toast_label, assignments.map { |a| [ "#{a.heading} (#{a.date_range})", a.id ] } ]
       end %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :assignment_id, label: "Assignment",
          error_attribute: :assignment,
          field: f.select(:assignment_id, grouped_options_for_select(choices, credential.assignment_id),
                          { include_blank: "None" }, class: "form-control", data: { testid: "assignment-field" }),
          hint: "Optional: the Assignment it was for. Choosing one sets its Engagement too." %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :skills_text, label: "Skills",
          error_attribute: :credential_skills,
          hint: "Optional. Separate Skills with commas; new names become Skills in the Uncategorised Skill Category." %>
  </div>

  <%# Verification div — how to check it %>
  <div class="show-panel" data-testid="<%= panel %>-panel-verification">
    <h2 class="show-panel__heading">Verification</h2>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :certificate_number, label: "Credential ID",
          hint: "Optional: the certificate or licence number, e.g. SSTBFCE-176004." %>
    <%= render "dossier/shared/field", f: f, record: credential, attribute: :verification_url, label: "Verification URL",
          hint: "Optional: where anyone can check it, e.g. the issuer's certificate lookup page." %>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to cancel_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
