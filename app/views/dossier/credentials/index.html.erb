<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Credentials</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Your degrees, certifications, courses and more, grouped by type, newest first; click a column heading to sort. Courses list the Completed ones; <%= link_to "Filter Courses", dossier_filter_courses_path %> lists the rest. Training shows a Skill was learned; it doesn't add to your years of experience.
  </p>
</div>

<% if @groups.any? %>
  <% @groups.each do |type, credentials| %>
    <details class="show-panel show-panel--collapsible" open data-testid="credential-group">
      <summary class="show-panel__heading"><%= type.name %></summary>
      <% if credentials.any? %>
        <%= render "table", credentials: credentials, taken_during: true, sort: @sort, provider_links: type.training?,
              table_testid: "credentials-table", row_testid: "credential-row" %>
      <% else %>
        <div class="empty-state" data-testid="empty-state">
          <p>No Completed <%= type.name.pluralize %>. <%= link_to "Filter Courses", dossier_filter_courses_path %> lists the rest.</p>
        </div>
      <% end %>
    </details>
  <% end %>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No Credentials yet. <%= link_to "Add A Credential", new_dossier_credential_path %>: a degree, certification or course you've taken.</p>
  </div>
<% end %>
