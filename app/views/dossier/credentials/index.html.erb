<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Training</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Courses you've taken, newest first. Training shows a Skill was learned; it doesn't add to your years of experience.
  </p>
</div>

<% if @credentials.any? %>
  <div class="data-table-wrapper">
    <table class="data-table dossier-training-table" data-testid="training-table">
      <thead>
        <tr>
          <th>Training</th>
          <th>Provider</th>
          <th>Dates</th>
          <th>Taken During</th>
          <th>Skills</th>
        </tr>
      </thead>
      <tbody>
        <% @credentials.each do |credential| %>
          <tr data-testid="training-row">
            <td><%= link_to credential.title, dossier_credential_path(credential), class: "data-table__name-link" %></td>
            <td><%= credential.provider&.short_name || "—" %></td>
            <td><%= credential.dates %></td>
            <td data-testid="training-taken-during">
              <% if credential.assignment %>
                <%= link_to credential.assignment.heading, dossier_assignment_path(credential.assignment) %>
              <% elsif credential.engagement %>
                <%= link_to credential.engagement.to_toast_label, dossier_engagement_path(credential.engagement) %>
              <% else %>
                —
              <% end %>
            </td>
            <td><%= credential.current_skills.map(&:name).join(", ").presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No Training yet. <%= link_to "Add Training", new_dossier_credential_path %> for a course you've taken.</p>
  </div>
<% end %>
