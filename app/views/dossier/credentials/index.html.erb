<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Credentials</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Your degrees, certifications, courses and more, grouped by type, newest first. Training shows a Skill was learned; it doesn't add to your years of experience.
  </p>
</div>

<% if @groups.any? %>
  <% @groups.each do |type, credentials| %>
    <div class="show-panel" data-testid="credential-group">
      <div class="show-panel__section">
        <h2 class="show-panel__heading"><%= type.name %></h2>
        <%= render "table", credentials: credentials, taken_during: true,
              table_testid: "credentials-table", row_testid: "credential-row" %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No Credentials yet. <%= link_to "Add A Credential", new_dossier_credential_path %>: a degree, certification or course you've taken.</p>
  </div>
<% end %>
