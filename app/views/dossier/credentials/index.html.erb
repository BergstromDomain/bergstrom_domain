<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Credentials</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Your degrees, certifications, courses and more, grouped by type, newest first. Training shows a Skill was learned; it doesn't add to your years of experience.
  </p>
</div>

<% if @groups.any? %>
  <% @groups.each do |type, credentials| %>
    <div class="show-panel" data-testid="credential-group">
      <div class="show-panel__section">
        <h2 class="show-panel__heading"><%= type.name %></h2>
        <div class="data-table-wrapper">
          <table class="data-table dossier-training-table" data-testid="credentials-table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Issued By</th>
                <th>Dates</th>
                <th>Taken During</th>
                <th>Skills</th>
              </tr>
            </thead>
            <tbody>
              <% credentials.each do |credential| %>
                <tr data-testid="credential-row">
                  <td><%= link_to credential.title, dossier_credential_path(credential), class: "data-table__name-link" %></td>
                  <td><%= credential.provider&.short_name || "—" %></td>
                  <td><%= credential.dates %></td>
                  <td data-testid="credential-taken-during">
                    <% if credential.assignment %>
                      <%= link_to credential.assignment.heading, dossier_assignment_path(credential.assignment) %>
                    <% elsif credential.engagement %>
                      <%= link_to credential.engagement.to_toast_label, dossier_engagement_path(credential.engagement) %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td><%= credential.current_skills.map(&:name).join(", ").presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No Credentials yet. <%= link_to "Add A Credential", new_dossier_credential_path %>: a degree, certification or course you've taken.</p>
  </div>
<% end %>
