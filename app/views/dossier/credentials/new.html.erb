<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Add Training</h1>
  </div>
</div>

<% cancel_path = if @credential.assignment then dossier_assignment_path(@credential.assignment)
                 elsif @credential.engagement then dossier_engagement_path(@credential.engagement)
                 else dossier_credentials_path
                 end %>
<%= render "form", credential: @credential, panel: "new", submit_label: "Add Training", cancel_path: cancel_path %>
