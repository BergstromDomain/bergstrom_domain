<%# The Training panel on an Engagement or Assignment page. Locals: credentials %>
<div class="show-panel" id="training" data-testid="training-panel">
  <div class="show-panel__section">
    <h2 class="show-panel__heading">Training</h2>
    <% if credentials.any? %>
      <%= render "dossier/credentials/table", credentials: credentials,
            table_testid: "training-table", row_testid: "training-row" %>
    <% else %>
      <p data-testid="training-empty">No Training yet.</p>
    <% end %>
  </div>
</div>
