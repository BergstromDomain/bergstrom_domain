<%# A list of Training (courses), newest first. Locals: credentials %>
<ul class="dossier-assignment-list" data-testid="training-list">
  <% credentials.each do |credential| %>
    <li class="dossier-assignment-row" data-testid="training-row">
      <span>
        <%= link_to credential.title, dossier_credential_path(credential), data: { testid: "training-title" } %>
        <% if credential.provider %>
          · <span data-testid="training-provider"><%= credential.provider.short_name %></span>
        <% end %>
      </span>
      <span class="dossier-assignment-row__dates"><%= credential.dates %></span>
    </li>
  <% end %>
</ul>
