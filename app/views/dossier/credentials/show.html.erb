<% policy = Policy.new(current_user, @credential) %>
<% if (warning = @credential.expiry_warning) %>
  <%= render "shared/toast", variant: "warning", message: warning, testid: "expiry-warning", dismissible: false %>
<% end %>
<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title" data-testid="credential-title"><%= @credential.title %></h1>
  </div>
</div>

<%# Main div — what it covered %>
<% if @credential.description %>
  <div class="show-panel" data-testid="show-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Description</h2>
      <p data-testid="credential-description"><%= @credential.description %></p>
    </div>
  </div>
<% end %>

<%# Metadata div %>
<div class="show-panel" data-testid="show-panel-metadata">
  <div class="show-meta-row">
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Type</h3>
      <p class="show-meta-cell__value" data-testid="credential-type">
        <%= link_to @credential.credential_type.name, dossier_credential_type_path(@credential.credential_type) %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Issued By</h3>
      <p class="show-meta-cell__value" data-testid="credential-provider">
        <%= @credential.provider ? link_to(@credential.provider.label, dossier_organisation_path(@credential.provider)) : "—" %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Dates</h3>
      <p class="show-meta-cell__value" data-testid="credential-dates">
        <%= @credential.dates %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Expires</h3>
      <p class="show-meta-cell__value" data-testid="credential-expires"><%= @credential.formatted_expiry || "—" %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Hours</h3>
      <p class="show-meta-cell__value" data-testid="credential-hours"><%= @credential.hours ? number_with_precision(@credential.hours, strip_insignificant_zeros: true) : "—" %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Taken During</h3>
      <p class="show-meta-cell__value" data-testid="credential-taken-during">
        <% if @credential.assignment %>
          <%= link_to @credential.assignment.to_toast_label, dossier_assignment_path(@credential.assignment) %>
        <% elsif @credential.engagement %>
          <%= link_to @credential.engagement.to_toast_label, dossier_engagement_path(@credential.engagement) %>
        <% else %>
          —
        <% end %>
      </p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Skills</h3>
      <p class="show-meta-cell__value" data-testid="credential-skills">
        <% skills = @credential.current_skills %>
        <%# One span: the cell is a flex row, whose gap would land before each comma. %>
        <span><%= skills.any? ? safe_join(skills.map { |skill| link_to(skill.display_name, dossier_skill_path(skill)) }, ", ") : "—" %></span>
      </p>
    </div>
  </div>
</div>

<%# Proof div — how to check it %>
<div class="show-panel" data-testid="show-panel-proof">
  <div class="show-meta-row">
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Credential ID</h3>
      <p class="show-meta-cell__value" data-testid="credential-number"><%= @credential.certificate_number || "—" %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Verification URL</h3>
      <p class="show-meta-cell__value" data-testid="credential-verification-url">
        <%= external_link(@credential.verification_url) %>
      </p>
    </div>
  </div>
</div>

<%# Certificates div — only the owner and admins see the files %>
<% if @credential.files_visible_to?(current_user) && @credential.files.attached? %>
  <div class="show-panel" data-testid="credential-files">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Certificates</h2>
      <ul class="dossier-assignment-list">
        <% @credential.files.each do |file| %>
          <li class="dossier-assignment-row">
            <%= link_to file.filename.to_s, dossier_credential_file_path(@credential, file), target: "_blank", rel: "noopener" %>
            <span class="dossier-assignment-row__dates"><%= number_to_human_size(file.byte_size) %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<%# Actions div %>
<div class="show-panel show-panel--actions" data-testid="show-panel-actions">
  <%= link_to dossier_credentials_path, class: "btn btn-secondary" do %>
    <%= lucide_icon("arrow-left", size: 16) %> Back
  <% end %>

  <% if policy.can_update? %>
    <span class="btn-divider">|</span>
    <%= link_to edit_dossier_credential_path(@credential), class: "btn btn-secondary" do %>
      <%= lucide_icon("pencil", size: 16) %> Edit Credential
    <% end %>
  <% end %>

  <% if policy.can_delete? %>
    <span class="btn-divider">|</span>
    <%= button_to dossier_credential_path(@credential),
          method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Delete #{@credential.title}? This cannot be undone." } do %>
      <%= lucide_icon("trash-2", size: 16) %> Delete Credential
    <% end %>
  <% end %>
</div>
