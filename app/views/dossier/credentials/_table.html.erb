<%# Credentials as a table: Title, Issued By, Dates, (Taken During,) Skills, (Status).
    Fixed column widths, so every table on a page lines up.
    Locals: credentials, table_testid, row_testid, taken_during (optional),
    sort (a Dossier::CredentialSort, optional: headings sort), status (optional),
    provider_links (optional: Issued By links to Browse Courses) %>
<% taken_during = local_assigns.fetch(:taken_during, false) %>
<% sort = local_assigns[:sort] %>
<% status = local_assigns.fetch(:status, false) %>
<% provider_links = local_assigns.fetch(:provider_links, false) %>
<% Dossier::Skill.preload_vendors(credentials.flat_map(&:current_skills)) %>
<div class="data-table-wrapper">
  <table class="data-table dossier-training-table dossier-credentials-table" data-testid="<%= table_testid %>">
    <colgroup>
      <col class="dossier-credentials-col--title">
      <col class="dossier-credentials-col--provider">
      <col class="dossier-credentials-col--dates">
      <% if taken_during %><col class="dossier-credentials-col--taken-during"><% end %>
      <col class="dossier-credentials-col--skills">
      <% if status %><col class="dossier-credentials-col--status"><% end %>
    </colgroup>
    <thead>
      <tr>
        <th><%= credential_sort_link(sort, "title") %></th>
        <th><%= credential_sort_link(sort, "provider") %></th>
        <th><%= credential_sort_link(sort, "dates") %></th>
        <% if taken_during %>
          <th><%= credential_sort_link(sort, "taken_during") %></th>
        <% end %>
        <th><%= credential_sort_link(sort, "skills") %></th>
        <% if status %>
          <th>Status</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% credentials.each do |credential| %>
        <tr data-testid="<%= row_testid %>">
          <td>
            <%= link_to credential.title, dossier_credential_path(credential), class: "data-table__name-link" %>
            <% if credential.expired? %>
              <span class="badge badge--suspended" data-testid="credential-expired"
                    title="Expired <%= credential.formatted_expiry %>">Expired</span>
            <% end %>
          </td>
          <td>
            <% if credential.provider && provider_links %>
              <%= link_to credential.provider.short_name, dossier_browse_courses_path(provider_id: credential.provider.to_param) %>
            <% else %>
              <%= credential.provider&.short_name || "—" %>
            <% end %>
          </td>
          <td><%= credential.dates %></td>
          <% if taken_during %>
            <td data-testid="credential-taken-during"><%= credential_taken_during(credential) %></td>
          <% end %>
          <td>
            <% skills = credential.current_skills %>
            <%= skills.any? ? safe_join(skills.map { |skill| link_to(skill.display_name, dossier_skill_path(skill)) }, ", ") : "—" %>
          </td>
          <% if status %>
            <td data-testid="credential-status"><%= credential.status_label %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
