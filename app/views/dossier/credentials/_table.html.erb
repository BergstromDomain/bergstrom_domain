<%# Credentials as a table: Title, Issued By, Dates, (Taken During,) Skills. Locals: credentials, table_testid, row_testid, taken_during (optional) %>
<% taken_during = local_assigns.fetch(:taken_during, false) %>
<% Dossier::Skill.preload_vendors(credentials.flat_map(&:current_skills)) %>
<div class="data-table-wrapper">
  <table class="data-table dossier-training-table" data-testid="<%= table_testid %>">
    <thead>
      <tr>
        <th>Title</th>
        <th>Issued By</th>
        <th>Dates</th>
        <% if taken_during %>
          <th>Taken During</th>
        <% end %>
        <th>Skills</th>
      </tr>
    </thead>
    <tbody>
      <% credentials.each do |credential| %>
        <tr data-testid="<%= row_testid %>">
          <td>
            <%= link_to credential.title, dossier_credential_path(credential), class: "data-table__name-link" %>
            <% if credential.expired? %>
              <span class="badge badge--suspended" data-testid="credential-expired"
                    title="Expired <%= credential.formatted_expiry %>">Expired</span>
            <% end %>
          </td>
          <td><%= credential.provider&.short_name || "—" %></td>
          <td><%= credential.dates %></td>
          <% if taken_during %>
            <td data-testid="credential-taken-during">
              <% if credential.assignment %>
                <%= link_to credential.assignment.heading, dossier_assignment_path(credential.assignment) %>
              <% elsif credential.engagement %>
                <%= link_to credential.engagement.to_toast_label, dossier_engagement_path(credential.engagement) %>
              <% else %>
                —
              <% end %>
            </td>
          <% end %>
          <td>
            <% skills = credential.current_skills %>
            <%= skills.any? ? safe_join(skills.map { |skill| link_to(skill.display_name, dossier_skill_path(skill)) }, ", ") : "—" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
