<%# Locals: colleague, panel ("new"/"edit"), submit_label %>
<% url = colleague.persisted? ? dossier_assignment_colleague_path(colleague.assignment, colleague) : dossier_assignment_colleagues_path(colleague.assignment) %>
<%= form_with model: colleague, url: url, class: "resource-form" do |f| %>
  <%= render "dossier/shared/form_errors", record: colleague, noun: "colleague" %>

  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <p class="form-hint">On <%= link_to colleague.assignment.to_toast_label, dossier_assignment_path(colleague.assignment) %>.
      Only you and Admins see Colleagues, and they're never on a CV.</p>
    <%= render "dossier/shared/contact_fields", f: f, record: colleague %>
  </div>

  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to dossier_assignment_path(colleague.assignment, anchor: "colleagues"), class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
