<%= render "dossier/shared/field", f: f, record: record, attribute: :name, label: "Name" %>
<%= render "dossier/shared/field", f: f, record: record, attribute: :parent_id, label: "Parent",
      error_attribute: :parent, hint: "Optional: makes this a sub-category, e.g. VoIP under Protocols & Standards. One level only.",
      field: f.collection_select(:parent_id, Dossier::SkillCategory.top_level.where.not(id: record.id).alphabetical,
                                 :id, :name, { include_blank: "None (top-level)" }, class: "form-control",
                                 data: { testid: "skill-category-parent-field" }) %>
<%= render "dossier/shared/field", f: f, record: record, attribute: :soft, label: "Soft Skills",
      hint: "Tick for soft skills such as Leadership. They're ticked on Achievements and Contributions and listed by those " \
            "examples instead of years, and never appear in a CV's skills. A sub-category of a soft category is soft too.",
      field: f.check_box(:soft, data: { testid: "skill-category-soft-field" }) %>
