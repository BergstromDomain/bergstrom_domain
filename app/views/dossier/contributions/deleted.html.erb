<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Deleted Contributions</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Deleted Contributions are kept for 30 days before being permanently removed.
  </p>
</div>

<% if @contributions.any? %>
  <div class="data-table-wrapper">
    <table class="data-table" data-testid="deleted-contribution-table">
      <colgroup>
        <col>
        <col style="width: 10rem;">
        <col style="width: 10rem;">
        <col style="width: 10rem;">
        <col style="width: 5rem;">
      </colgroup>
      <thead>
        <tr>
          <th>Contribution</th>
          <th>Date</th>
          <th>Deleted</th>
          <th>Days remaining</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @contributions.each do |contribution| %>
          <tr data-testid="deleted-contribution-row">
            <td><%= contribution.title %></td>
            <td><%= contribution.date %></td>
            <td><%= contribution.deleted_at.to_date.to_fs(:long) %></td>
            <td data-testid="deleted-contribution-days-remaining"><%= ((contribution.purge_at - Time.current) / 1.day).ceil %></td>
            <td class="data-table__icon-cell">
              <%= button_to restore_dossier_contribution_path(contribution),
                    method: :post,
                    class: "icon-button icon-button--success",
                    title: "Restore #{contribution.to_toast_label}",
                    data: { testid: "restore-contribution-#{contribution.id}" } do %>
                <%= lucide_icon("undo-2", size: 18) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No deleted Contributions.</p>
  </div>
<% end %>
