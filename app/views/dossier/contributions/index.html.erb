<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Contributions</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Talks, workshops, articles and other community work you've given, grouped by kind, newest first. They stand on their own, outside your Engagements.
  </p>
</div>

<% if @groups.any? %>
  <% @groups.each do |kind, contributions| %>
    <details class="show-panel show-panel--collapsible" open data-testid="contribution-group">
      <summary class="show-panel__heading" data-testid="contribution-group-heading"><%= Dossier::Contribution::KINDS.dig(kind, 1) %></summary>
      <div class="data-table-wrapper">
        <table class="data-table dossier-contributions-table" data-testid="contributions-<%= kind %>">
          <colgroup>
            <col class="dossier-contributions-col--title">
            <col class="dossier-contributions-col--event">
            <col class="dossier-contributions-col--date">
            <col class="dossier-contributions-col--skills">
          </colgroup>
          <thead>
            <tr>
              <th>Title</th>
              <th>Event</th>
              <th>Date</th>
              <th>Skills</th>
            </tr>
          </thead>
          <tbody>
            <% contributions.each do |contribution| %>
              <tr data-testid="contribution-row">
                <td><%= link_to contribution.title, dossier_contribution_path(contribution), class: "data-table__name-link",
                          data: { testid: "contribution-title" } %></td>
                <td><%= contribution.event ? link_to(contribution.event.name, dossier_organisation_path(contribution.event)) : "—" %></td>
                <td><%= contribution.date %></td>
                <td><%= contribution.current_skills.map(&:name).join(", ").presence || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  <% end %>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No Contributions yet. <%= link_to "Add A Contribution", new_dossier_contribution_path %>: a talk, workshop, article or other community work.</p>
  </div>
<% end %>
