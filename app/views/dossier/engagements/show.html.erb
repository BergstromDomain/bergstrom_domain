<% policy = Policy.new(current_user, @engagement) %>
<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title"><%= @engagement.to_toast_label %></h1>
  </div>
</div>

<%# Main div — summary %>
<% if @engagement.summary %>
  <div class="show-panel" data-testid="show-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Summary</h2>
      <p data-testid="engagement-summary"><%= @engagement.summary %></p>
    </div>
  </div>
<% end %>

<%# Metadata div %>
<div class="show-panel" data-testid="show-panel-metadata">
  <div class="show-meta-row">
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Employer</h3>
      <p class="show-meta-cell__value" data-testid="engagement-employer"><%= @engagement.employer.label %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Employment Type</h3>
      <p class="show-meta-cell__value" data-testid="engagement-employment-type"><%= @engagement.employment_type.name %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Position Title</h3>
      <p class="show-meta-cell__value"><%= @engagement.position_title %></p>
    </div>
    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Dates</h3>
      <p class="show-meta-cell__value" data-testid="engagement-dates"><%= @engagement.date_range %></p>
    </div>
  </div>
</div>

<%# Assignments div %>
<div class="show-panel" data-testid="engagement-assignments">
  <div class="show-panel__section">
    <h2 class="show-panel__heading">Assignments</h2>
    <% if @engagement.assignments.any? %>
      <%= render "dossier/engagements/assignment_list", engagement: @engagement,
                 bench: Dossier::Timeline.bench_for(@engagement) %>
    <% else %>
      <p>No Assignments yet.</p>
    <% end %>
  </div>
</div>

<%# Actions div %>
<div class="show-panel show-panel--actions" data-testid="show-panel-actions">
  <%= link_to dossier_engagements_path, class: "btn btn-secondary" do %>
    <%= lucide_icon("arrow-left", size: 16) %> Back
  <% end %>

  <% if policy.can_update? %>
    <span class="btn-divider">|</span>
    <%= link_to new_dossier_assignment_path(engagement_id: @engagement.id), class: "btn btn-primary-action" do %>
      <%= lucide_icon("plus", size: 16) %> Add Assignment
    <% end %>
    <span class="btn-divider">|</span>
    <%= link_to edit_dossier_engagement_path(@engagement), class: "btn btn-secondary" do %>
      <%= lucide_icon("pencil", size: 16) %> Edit Engagement
    <% end %>
  <% end %>

  <% if policy.can_delete? %>
    <span class="btn-divider">|</span>
    <%= button_to dossier_engagement_path(@engagement),
          method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Delete #{@engagement.to_toast_label} and its Assignments?" } do %>
      <%= lucide_icon("trash-2", size: 16) %> Delete Engagement
    <% end %>
  <% end %>
</div>
