<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Timeline</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Your Engagements, newest first, with their Assignments, bench time and the gaps between them.
  </p>
</div>

<% entries = @timeline.entries %>
<% if entries.any? %>
  <% entries.each do |entry| %>
    <% if entry.kind == :gap %>
      <p class="dossier-timeline-gap" data-testid="timeline-gap">
        <span class="dossier-timeline-gap__label">
          <%= lucide_icon("clock", size: 14) %>
          <%= link_to "Gap · #{entry.duration}", period_path_for(entry.period), data: { testid: "timeline-gap-label" } %>
        </span>
        <span class="dossier-assignment-row__dates"><%= entry.date_range %></span>
      </p>
    <% else %>
      <% engagement = entry.engagement %>
      <div class="show-panel" data-testid="engagement-card">
        <div class="show-panel__section">
          <h2 class="show-panel__heading dossier-timeline-card__title" data-testid="engagement-title">
            <%= link_to engagement.to_toast_label, dossier_engagement_path(engagement), class: "data-table__name-link" %>
          </h2>
          <p class="dossier-timeline-card__meta">
            <span data-testid="engagement-type"><%= engagement.employment_type.name %></span>
            <span class="dossier-assignment-row__dates" data-testid="engagement-dates"><%= engagement.date_range %></span>
          </p>
          <%= render "dossier/engagements/assignment_list", engagement: engagement, bench: entry.bench %>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No Engagements yet. <%= link_to "Create An Engagement", new_dossier_engagement_path %> to start your Timeline.</p>
  </div>
<% end %>
