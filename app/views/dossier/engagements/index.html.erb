<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Timeline</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Your Engagements, newest first, with their Assignments, bench time and the gaps between them.
  </p>
</div>

<% entries = @timeline.entries %>
<% if entries.any? %>
  <% entries.each do |entry| %>
    <% if entry.kind == :gap %>
      <p class="dossier-timeline-gap" data-testid="timeline-gap">
        <%= lucide_icon("clock", size: 14) %> Gap · <%= entry.date_range %> · <%= entry.duration %>
      </p>
    <% else %>
      <% engagement = entry.engagement %>
      <div class="show-panel" data-testid="engagement-card">
        <div class="show-panel__section">
          <h2 class="show-panel__heading" data-testid="engagement-title">
            <%= link_to engagement.to_toast_label, dossier_engagement_path(engagement), class: "data-table__name-link" %>
          </h2>
          <p><%= engagement.employment_type.name %> · <%= engagement.date_range %></p>
          <% rows = engagement.assignments.map { |a| [ a.effective_end || Date.current, a ] } +
                    entry.bench.map { |period| [ period.to, period ] } %>
          <% if rows.any? %>
            <ul class="dossier-assignment-list">
              <% rows.sort_by(&:first).reverse_each do |_, row| %>
                <% if row.is_a?(Dossier::Assignment) %>
                  <%= render "dossier/assignments/row", assignment: row %>
                <% else %>
                  <li class="dossier-assignment-row dossier-assignment-row--bench" data-testid="timeline-bench">
                    <span data-testid="timeline-bench-label">Bench · <%= row.duration %></span>
                    <span class="dossier-assignment-row__dates"><%= row.date_range %></span>
                  </li>
                <% end %>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No Engagements yet. <%= link_to "Create An Engagement", new_dossier_engagement_path %> to start your Timeline.</p>
  </div>
<% end %>
