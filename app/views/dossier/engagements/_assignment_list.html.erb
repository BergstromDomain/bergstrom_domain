<%#
  An Engagement's Assignments in their hand-made order, each with its client's
  logo, then its bench time, newest first. Locals: engagement, bench
  (Dossier::Timeline::Period list); sortable (optional, true for Up/Down).
%>
<% assignments = engagement.assignments.to_a %>
<% if assignments.any? || bench.any? %>
  <ul class="dossier-assignment-list">
    <% assignments.each_with_index do |assignment, index| %>
      <%= render "dossier/assignments/row", assignment: assignment, logo: true,
                 moves: (local_assigns[:sortable] ? { first: index.zero?, last: index == assignments.size - 1 } : nil) %>
    <% end %>
    <% bench.sort_by(&:to).reverse_each do |period| %>
      <li class="dossier-assignment-row dossier-assignment-row--bench" data-testid="timeline-bench">
        <%= link_to "Bench · #{period.duration}", period_path_for(period), data: { testid: "timeline-bench-label" } %>
        <span class="dossier-assignment-row__dates"><%= period.date_range %></span>
      </li>
    <% end %>
  </ul>
<% end %>
