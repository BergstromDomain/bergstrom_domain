<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Experience</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Your years of experience, counted from calendar overlap so nothing is counted twice. Personal projects are counted on their own. Years per Skill are on <%= link_to "My Skills", dossier_my_skills_path %>.
  </p>
</div>

<% totals = @calculator.totals %>
<% if totals.career_months || totals.personal_months %>
  <%# Totals div %>
  <div class="show-panel" data-testid="show-panel-totals">
    <div class="show-meta-row">
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Career</h3>
        <p class="show-meta-cell__value" data-testid="experience-career"
           title="Time covered by your Engagements, bench time included"><%= totals.career %></p>
      </div>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">On Assignments</h3>
        <p class="show-meta-cell__value" data-testid="experience-on-assignments"
           title="Time covered by your Assignments, bench time left out"><%= totals.on_assignments %></p>
      </div>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Personal Projects</h3>
        <p class="show-meta-cell__value" data-testid="experience-personal"><%= totals.personal %></p>
      </div>
    </div>
  </div>

  <% Dossier::ExperienceController::SECTIONS.each do |testid, heading, slice| %>
    <% rows = @calculator.slice(slice) %>
    <% next if rows.empty? %>
    <div class="show-panel" data-testid="experience-<%= testid %>">
      <div class="show-panel__section">
        <h2 class="show-panel__heading"><%= heading %></h2>
        <div class="data-table-wrapper">
          <table class="data-table dossier-skill-table">
            <thead>
              <tr>
                <th><%= heading.singularize %></th>
                <th>Years</th>
                <th>Dates</th>
                <th class="text-center">Assignments</th>
              </tr>
            </thead>
            <tbody>
              <% rows.each do |row| %>
                <tr data-testid="experience-row">
                  <td><%= row.key ? link_to(row.label, polymorphic_path(row.key), class: "data-table__name-link") : row.label %></td>
                  <td><%= row.duration %></td>
                  <td><%= row.date_range %></td>
                  <td class="text-center"><%= row.assignment_count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No experience yet. It comes from your <%= link_to "Engagements and Assignments", dossier_engagements_path %>.</p>
  </div>
<% end %>
