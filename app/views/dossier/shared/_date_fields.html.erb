<%#
  Year + month + optional day for one edge of a Dossier::Dated record.
  Locals: f, record, edge (:start / :end), label ("Start" / "End"); optional hint.
%>
<% month_errors = record.errors[:"#{edge}_month"] %>
<% day_errors = record.errors[:"#{edge}_day"] %>
<div class="show-panel__section">
  <h2 class="show-panel__heading"><%= label %></h2>
  <div class="form-row">
    <div class="form-group">
      <%= f.label :"#{edge}_year", "#{label} Year" %>
      <%= f.number_field :"#{edge}_year", in: 1900..2100, placeholder: "e.g. 2019",
            class: "form-control #{'form-control--error' if month_errors.any?}",
            data: { testid: "#{edge}-year-field" } %>
    </div>
    <div class="form-group">
      <%= f.label :"#{edge}_month_number", "#{label} Month" %>
      <%= f.select :"#{edge}_month_number", Date::MONTHNAMES.compact.each_with_index.map { |name, i| [ name, (i + 1).to_s ] },
            { include_blank: "Choose a month" },
            class: "form-control #{'form-control--error' if month_errors.any?}",
            data: { testid: "#{edge}-month-field" } %>
    </div>
    <div class="form-group">
      <%= f.label :"#{edge}_day", "#{label} Day" %>
      <%= f.number_field :"#{edge}_day", in: 1..31, placeholder: "Optional",
            class: "form-control #{'form-control--error' if day_errors.any?}",
            data: { testid: "#{edge}-day-field" } %>
    </div>
  </div>
  <% (month_errors + day_errors).each do |error| %>
    <span class="field-error" data-testid="field-error"><%= error %></span>
  <% end %>
  <% if local_assigns[:hint] %>
    <p class="form-hint"><%= hint %></p>
  <% end %>
</div>
