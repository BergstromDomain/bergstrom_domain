<%# Colleagues or Staff (Dossier::ContactDetails) as a table.
    Locals: contacts, row_testid, table_testid, editable, edit_path (contact → path), delete_path (contact → path) %>
<div class="data-table-wrapper">
  <table class="data-table" data-testid="<%= table_testid %>">
    <thead>
      <tr>
        <th>Name</th>
        <th>Position</th>
        <th>Mobile</th>
        <th>Email</th>
        <th>LinkedIn</th>
        <th>Comment</th>
        <% if editable %><th></th><% end %>
      </tr>
    </thead>
    <tbody>
      <% contacts.each do |contact| %>
        <tr data-testid="<%= row_testid %>">
          <td><%= contact.name %></td>
          <td><%= contact.position || "—" %></td>
          <td><%= contact.mobile || "—" %></td>
          <td><%= contact.email ? mail_to(contact.email) : "—" %></td>
          <td><%= contact.linkedin_url ? link_to("LinkedIn", contact.linkedin_url, target: "_blank", rel: "noopener") : "—" %></td>
          <td><%= contact.comment || "—" %></td>
          <% if editable %>
            <td class="data-table__actions">
              <%= link_to "Edit", edit_path.call(contact), class: "btn btn-secondary" %>
              <%= button_to "Delete", delete_path.call(contact), method: :delete,
                    class: "btn btn-danger", form: { style: "display: inline" },
                    data: { turbo_confirm: "Delete #{contact.name}? This cannot be undone." } %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
