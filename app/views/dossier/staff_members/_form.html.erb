<%# Locals: assignment, partner, staff_member, panel ("new"/"edit"), submit_label %>
<% url = staff_member.persisted? ? dossier_assignment_partner_staff_member_path(assignment, partner, staff_member) : dossier_assignment_partner_staff_members_path(assignment, partner) %>
<%= form_with model: staff_member, url: url, class: "resource-form" do |f| %>
  <%= render "dossier/shared/contact_errors", record: staff_member, noun: "staff member" %>

  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <p class="form-hint">At <%= partner.organisation.name %> (<%= partner.kind_label %>) on
      <%= link_to assignment.to_toast_label, dossier_assignment_path(assignment) %>.
      Only you and Admins see Staff, and they're never on a CV.</p>
    <%= render "dossier/shared/contact_fields", f: f, record: staff_member,
          change_path: (new_dossier_assignment_partner_staff_member_path(assignment, partner) if staff_member.new_record?) %>
  </div>

  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to dossier_assignment_path(assignment, anchor: partner.kind.pluralize), class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
