<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">CV Variants</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    Tailored CVs picked from your master data, one per application or kind of role.
  </p>
</div>

<% if @variants.any? %>
  <div class="show-panel">
    <div class="data-table-wrapper">
      <table class="data-table" data-testid="cv-variants-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Target</th>
            <th>Voice</th>
            <th>Updated</th>
          </tr>
        </thead>
        <tbody>
          <% @variants.each do |variant| %>
            <tr data-testid="cv-variant-row">
              <td><%= link_to variant.name, dossier_cv_variant_path(variant), class: "data-table__name-link" %></td>
              <td><%= variant.target_label || "—" %></td>
              <td><%= variant.voice_label %></td>
              <td><%= variant.updated_at.strftime("%-d %b %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No CV Variants yet. <%= link_to "Create A CV Variant", new_dossier_cv_variant_path %> to tailor your CV for an application.</p>
  </div>
<% end %>
