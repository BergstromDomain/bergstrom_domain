<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title"><%= plural_name %></h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered"><%= subtitle %></p>
</div>

<% if @available_letters.any? %>
  <nav class="az-nav" data-testid="az-nav">
    <%= link_to "All", dossier_organisations_path,
          class: "az-nav__link #{'az-nav__link--active' if @selected_letter.nil?}", data: { testid: "az-nav-all" } %>
    <% Person::BUCKET_LETTERS.each do |letter| %>
      <% if @available_letters.include?(letter) %>
        <%= link_to letter, dossier_organisations_path(letter: letter),
              class: "az-nav__link #{'az-nav__link--active' if @selected_letter == letter}", data: { testid: "az-nav-link" } %>
      <% else %>
        <span class="az-nav__link az-nav__link--disabled" data-testid="az-nav-link-disabled"><%= letter %></span>
      <% end %>
    <% end %>
  </nav>
<% end %>

<% if @records.any? %>
  <div class="dossier-organisation-cards" data-testid="organisation-cards">
    <% @records.each do |record| %>
      <div class="show-panel dossier-organisation-card" data-testid="reference-data-row">
        <div class="dossier-organisation-card__head" data-testid="organisation-card-head">
          <%= organisation_logo(record) %>
          <%= link_to record.to_toast_label, dossier_organisation_path(record),
                class: "data-table__name-link dossier-organisation-card__name", data: { testid: "reference-data-name" } %>
          <%# Shown without its scheme or a trailing slash %>
          <span class="dossier-organisation-card__website" data-testid="reference-data-website">
            <% if record.website_url %>
              <%= link_to record.website_url.sub(%r{\Ahttps?://}i, "").delete_suffix("/"), record.website_url,
                    rel: "noopener", target: "_blank" %>
            <% end %>
          </span>
        </div>
        <% if record.description.present? %>
          <div class="dossier-organisation-card__description" data-testid="reference-data-description">
            <%= simple_format(record.description) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% elsif @selected_letter %>
  <div class="empty-state" data-testid="organisations-letter-empty">
    <p>No Organisations start with <%= @selected_letter %>.</p>
  </div>
<% else %>
  <div class="empty-state" data-testid="empty-state">
    <p>No organisations have been added yet.</p>
  </div>
<% end %>
