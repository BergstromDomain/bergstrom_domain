<%# The signed-in user's own Credentials this Organisation issued (@credentials). %>
<% if @credentials&.any? %>
  <div class="show-panel" data-testid="organisation-credentials">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Your Credentials</h2>
      <%= render "dossier/credentials/list", credentials: @credentials %>
    </div>
  </div>
<% end %>
