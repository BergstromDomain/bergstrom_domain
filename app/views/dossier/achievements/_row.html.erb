<%#
  One Achievement in the bulleted table (see _table): its text, a marker
  when it has a Situation or Task (their text is on its page), its Impact,
  Tech Skills and Soft Skills, then importance. Locals: achievement; moves
  (nil, or { first:, last: } to show Up/Down).
%>
<tr class="dossier-achievement" data-testid="achievement-row">
  <td class="dossier-achievement__body">
    <%= link_to achievement.text, dossier_achievement_path(achievement), data: { testid: "achievement-link" } %>
    <%# The Situation and Task are private (owner and Admins only): just marked here %>
    <% if achievement.star_notes_visible_to?(current_user) %>
      <% saved = [ ("Situation" if achievement.situation_visible_to?(current_user)), ("Task" if achievement.task_visible_to?(current_user)) ].compact %>
      <span class="dossier-achievement__star" title="<%= saved.join(" and ") %> saved, on the Achievement's page"
            data-testid="achievement-row-star"><%= saved.map(&:first).join %></span>
    <% end %>
    <%# The Impact (the Result), then the Skills it shows %>
    <% parts = [] %>
    <% if achievement.impact %>
      <% parts << tag.span(safe_join([ tag.strong("Impact:"), " ", achievement.impact ]), data: { testid: "achievement-row-impact" }) %>
    <% end %>
    <% tech_skills = achievement.technical_skills %>
    <% if tech_skills.any? %>
      <% links = safe_join(tech_skills.map { |skill| link_to(skill.display_name, dossier_skill_path(skill)) }, ", ") %>
      <% parts << tag.span(safe_join([ tag.strong("Tech Skills:"), " ", links ]), data: { testid: "achievement-row-tech-skills" }) %>
    <% end %>
    <% soft_skills = achievement.soft_skills %>
    <% if soft_skills.any? %>
      <% links = safe_join(soft_skills.map { |skill| link_to(skill.display_name, dossier_skill_path(skill)) }, ", ") %>
      <% parts << tag.span(safe_join([ tag.strong("Soft Skills:"), " ", links ]), data: { testid: "achievement-row-skills" }) %>
    <% end %>
    <% if parts.any? %>
      <p class="dossier-achievement__meta"><%= safe_join(parts, " · ") %></p>
    <% end %>
  </td>
  <td class="text-center" data-testid="achievement-row-importance"><%= achievement.importance %></td>
  <% if moves %>
    <td class="dossier-achievement__moves">
      <%= button_to move_dossier_achievement_path(achievement, direction: "up"), method: :patch,
            class: "icon-button", title: "Move up", disabled: moves[:first],
            data: { testid: "achievement-move-up" } do %>
        <%= lucide_icon("arrow-up", size: 16) %>
      <% end %>
      <%= button_to move_dossier_achievement_path(achievement, direction: "down"), method: :patch,
            class: "icon-button", title: "Move down", disabled: moves[:last],
            data: { testid: "achievement-move-down" } do %>
        <%= lucide_icon("arrow-down", size: 16) %>
      <% end %>
    </td>
  <% end %>
</tr>
