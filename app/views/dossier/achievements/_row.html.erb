<%#
  One Achievement in a numbered list: its text, then importance, impact and
  Skills. Locals: achievement; moves (nil, or { first:, last: } to show Up/Down).
%>
<li class="dossier-achievement" data-testid="achievement-row">
  <div class="dossier-achievement__body">
    <%= link_to achievement.text, dossier_achievement_path(achievement), data: { testid: "achievement-link" } %>
    <p class="dossier-achievement__meta">
      <span data-testid="achievement-row-importance">Importance <%= achievement.importance %></span>
      <% if achievement.impact %>
        <span data-testid="achievement-row-impact">· <%= achievement.impact %></span>
      <% end %>
      <% if achievement.current_skills.any? %>
        <span data-testid="achievement-row-skills">· <%= achievement.current_skills.map(&:name).join(", ") %></span>
      <% end %>
    </p>
  </div>
  <% if moves %>
    <span class="dossier-achievement__moves">
      <%= button_to move_dossier_achievement_path(achievement, direction: "up"), method: :patch,
            class: "icon-button", title: "Move up", disabled: moves[:first],
            data: { testid: "achievement-move-up" } do %>
        <%= lucide_icon("arrow-up", size: 16) %>
      <% end %>
      <%= button_to move_dossier_achievement_path(achievement, direction: "down"), method: :patch,
            class: "icon-button", title: "Move down", disabled: moves[:last],
            data: { testid: "achievement-move-down" } do %>
        <%= lucide_icon("arrow-down", size: 16) %>
      <% end %>
    </span>
  <% end %>
</li>
