<% policy = Policy.new(current_user, @achievement) %>
<% assignment = @achievement.assignment %>
<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title">Achievement</h1>
  </div>
  <p class="page-header__subtitle page-header__subtitle--centered">
    <%= link_to assignment.to_toast_label, dossier_assignment_path(assignment), data: { testid: "achievement-assignment" } %>
  </p>
</div>

<%# Main div — laid out like the Edit form, in STAR order: Situation and Task (owner and Admins only), the bullet point (the Action), then the Impact (the Result) %>
<div class="show-panel" data-testid="show-panel-main">
  <% if @achievement.situation_visible_to?(current_user) %>
    <div class="show-panel__section">
      <h2 class="show-panel__heading">
        Situation
        <%= render "shared/info_tip", text: "Only you and Admins see this, and it's never on a CV.", testid: "achievement-situation-info" %>
      </h2>
      <p data-testid="achievement-situation"><%= @achievement.situation %></p>
    </div>
  <% end %>
  <% if @achievement.task_visible_to?(current_user) %>
    <div class="show-panel__section">
      <h2 class="show-panel__heading">
        Task
        <%= render "shared/info_tip", text: "Only you and Admins see this, and it's never on a CV.", testid: "achievement-task-info" %>
      </h2>
      <p data-testid="achievement-task"><%= @achievement.task %></p>
    </div>
  <% end %>
  <div class="show-panel__section">
    <h2 class="show-panel__heading">Achievement</h2>
    <p data-testid="achievement-text"><%= @achievement.text %></p>
  </div>
  <% if @achievement.impact %>
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Impact</h2>
      <p data-testid="achievement-impact"><%= @achievement.impact %></p>
    </div>
  <% end %>
</div>

<%# Details div — as the Edit form's second panel: Importance, Soft Skills, Technical Skills %>
<div class="show-panel" data-testid="show-panel-details">
  <div class="show-panel__section">
    <h2 class="show-panel__heading">Importance</h2>
    <p data-testid="achievement-importance"><%= importance_label(@achievement.importance) %></p>
  </div>
  <% [ [ "Soft Skills", @achievement.soft_skills, "achievement-soft-skills" ],
       [ "Technical Skills", @achievement.technical_skills, "achievement-skills" ] ].each do |label, skills, testid| %>
    <div class="show-panel__section">
      <h2 class="show-panel__heading"><%= label %></h2>
      <p data-testid="<%= testid %>">
        <%= skills.any? ? safe_join(skills.map { |skill| link_to(skill.display_name, dossier_skill_path(skill)) }, ", ") : "—" %>
      </p>
    </div>
  <% end %>
</div>

<%# Actions div %>
<div class="show-panel show-panel--actions" data-testid="show-panel-actions">
  <%= link_to dossier_assignment_path(assignment), class: "btn btn-secondary" do %>
    <%= lucide_icon("arrow-left", size: 16) %> Back
  <% end %>

  <% if policy.can_update? %>
    <span class="btn-divider">|</span>
    <%= link_to edit_dossier_achievement_path(@achievement), class: "btn btn-secondary" do %>
      <%= lucide_icon("pencil", size: 16) %> Edit Achievement
    <% end %>
  <% end %>

  <% if policy.can_delete? %>
    <span class="btn-divider">|</span>
    <%= button_to dossier_achievement_path(@achievement),
          method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Delete this Achievement? You can restore it for 30 days." } do %>
      <%= lucide_icon("trash-2", size: 16) %> Delete Achievement
    <% end %>
  <% end %>
</div>
