<%# app/views/blog_posts/show.html.erb %>

<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title" data-testid="blog-post-title"><%= @blog_post.title %></h1>
  </div>
</div>

<%# Main div — image/category-icon + body %>
<div class="show-panel" data-testid="show-panel-main">
  <% if @blog_post.blog_image.attached? %>
    <div class="event-image" data-testid="blog-post-image">
      <%= image_tag @blog_post.blog_image, alt: @blog_post.title, class: "event-image__full" %>
    </div>
  <% elsif @blog_post.blog_category.present? %>
    <span class="event-type-icon-large" data-testid="blog-post-category-icon">
      <%= lucide_icon(@blog_post.blog_category.icon, size: 64) %>
    </span>
  <% end %>

  <div class="show-panel__section">
    <%= sanitize @blog_post.rendered_body,
          tags:       BlogPost::RENDERED_BODY_ALLOWED_TAGS,
          attributes: BlogPost::RENDERED_BODY_ALLOWED_ATTRIBUTES %>
  </div>
</div>

<%# Metadata div %>
<div class="show-panel" data-testid="show-panel-metadata">
  <div class="show-meta-row">
    <% if @blog_post.blog_category.present? %>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Category</h3>
        <p class="show-meta-cell__value" data-testid="blog-post-category">
          <%= lucide_icon(@blog_post.blog_category.icon, size: 16) %>
          <%= link_to @blog_post.blog_category.name, blog_category_path(@blog_post.blog_category) %>
        </p>
      </div>
    <% end %>

    <% if @blog_post.sub_category.present? %>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Sub Category</h3>
        <p class="show-meta-cell__value" data-testid="blog-post-sub-category"><%= @blog_post.sub_category %></p>
      </div>
    <% end %>

    <% if @blog_post.topic.present? %>
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Topic</h3>
        <p class="show-meta-cell__value" data-testid="blog-post-topic"><%= @blog_post.topic %></p>
      </div>
    <% end %>

    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label"><%= @blog_post.authors.size == 1 ? "Author" : "Authors" %></h3>
      <p class="show-meta-cell__value" data-testid="blog-post-authors">
        <%= @blog_post.authors.map { |author| "#{author.first_name} #{author.last_name}" }.join(", ") %>
      </p>
    </div>

    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Comments</h3>
      <p class="show-meta-cell__value" data-testid="blog-post-comments-count"><%= @blog_post.comments_count %></p>
    </div>

    <div class="show-meta-cell">
      <h3 class="show-meta-cell__label">Likes</h3>
      <p class="show-meta-cell__value" data-testid="blog-post-likes-count"><%= @blog_post.likes_count %></p>
    </div>
  </div>
</div>

<%# Actions div %>
<div class="show-panel show-panel--actions" data-testid="show-panel-actions">
  <%= link_to chronicle_path, class: "btn btn-secondary" do %>
    <%= lucide_icon("arrow-left", size: 16) %> Back to Chronicle
  <% end %>

  <% if @policy.can_update? %>
    <span class="btn-divider">|</span>
    <%= link_to edit_blog_post_path(@blog_post), class: "btn btn-secondary" do %>
      <%= lucide_icon("pencil", size: 16) %> Edit
    <% end %>

    <span class="btn-divider">|</span>
    <% if @blog_post.published? %>
      <%= button_to unpublish_blog_post_path(@blog_post),
            method: :post,
            class: "btn btn-secondary",
            data: { testid: "unpublish-button" } do %>
        <%= lucide_icon("eye-off", size: 16) %> Unpublish
      <% end %>
    <% else %>
      <%= button_to publish_blog_post_path(@blog_post),
            method: :post,
            class: "btn btn-primary",
            data: { testid: "publish-button" } do %>
        <%= lucide_icon("upload", size: 16) %> Publish
      <% end %>
    <% end %>
  <% end %>
</div>
