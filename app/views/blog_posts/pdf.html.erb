<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: #2c2825;
    margin: 0;
    padding: 2rem;
  }
  .pdf-title {
    color: #b07d56;
    margin: 0 0 0.5rem;
  }
  .pdf-meta {
    color: #6b6460;
    font-size: 0.875rem;
    margin: 0 0 1.5rem;
  }
  .pdf-image {
    max-width: 100%;
    margin-bottom: 1.5rem;
    border-radius: 4px;
  }
  .pdf-body {
    line-height: 1.6;
  }
  .pdf-body img {
    max-width: 100%;
  }
  .pdf-body pre {
    padding: 1rem;
    border: 1px solid #e2ddd6;
    border-radius: 4px;
    overflow-x: auto;
    font-family: ui-monospace, "Cascadia Code", "Source Code Pro", monospace;
  }
  .pdf-body code {
    font-family: ui-monospace, "Cascadia Code", "Source Code Pro", monospace;
  }
  .pdf-body a {
    color: #b07d56;
  }
</style>
</head>
<body>
  <h1 class="pdf-title"><%= @blog_post.title %></h1>
  <p class="pdf-meta">
    <% if @blog_post.blog_category.present? %><%= @blog_post.blog_category.name %> &middot; <% end %>
    By <%= @blog_post.authors.map { |author| "#{author.first_name} #{author.last_name}" }.join(", ") %>
    &middot; <%= @blog_post.created_at.strftime("%d %B %Y") %>
  </p>

  <% if @blog_post.blog_image.attached? %>
    <img class="pdf-image" src="<%= blog_image_data_uri(@blog_post) %>" alt="<%= @blog_post.title %>">
  <% end %>

  <div class="pdf-body">
    <%= sanitize @blog_post.rendered_body,
          tags:       BlogPost::RENDERED_BODY_ALLOWED_TAGS,
          attributes: BlogPost::RENDERED_BODY_ALLOWED_ATTRIBUTES %>
  </div>
</body>
</html>
