<div class="page-header">
  <div class="page-header__top page-header__top--centered">
    <h1 class="page-title" data-testid="food-type-name"><%= @food_type.name %></h1>
  </div>
</div>

<div class="page-content--half">
  <%# Main div — icon + description %>
  <div class="show-panel" data-testid="show-panel-main">
    <div class="show-panel__section">
      <span class="event-type-icon-large" data-testid="food-type-icon">
        <%= lucide_icon(@food_type.icon, size: 64) %>
      </span>
    </div>

    <div class="show-panel__section">
      <h2 class="show-panel__heading">Description</h2>
      <p data-testid="food-type-description"><%= @food_type.description %></p>
    </div>
  </div>

  <%# Metadata div %>
  <div class="show-panel" data-testid="show-panel-metadata">
    <div class="show-meta-row">
      <div class="show-meta-cell">
        <h3 class="show-meta-cell__label">Food Type Name</h3>
        <p class="show-meta-cell__value" data-testid="food-type-name-value"><%= @food_type.name %></p>
      </div>
    </div>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="show-panel-actions">
    <%= link_to food_types_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("arrow-left", size: 16) %> Back
    <% end %>

    <% if @policy.can_update? %>
      <span class="btn-divider">|</span>
      <%= link_to edit_food_type_path(@food_type), class: "btn btn-secondary" do %>
        <%= lucide_icon("pencil", size: 16) %> Edit Food Type
      <% end %>
    <% end %>

    <% if @policy.can_delete? %>
      <span class="btn-divider">|</span>
      <%= button_to food_type_path(@food_type),
            method: :delete,
            class: "btn btn-danger",
            data: { turbo_confirm: "Delete #{@food_type.name}? This cannot be undone." } do %>
        <%= lucide_icon("trash-2", size: 16) %> Delete Food Type
      <% end %>
    <% end %>
  </div>
</div>
