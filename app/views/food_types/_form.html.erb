<%# Locals: panel ("new"/"edit"), submit_label, cancel_path %>
<%= form_with model: food_type, class: "resource-form" do |f| %>
  <% if food_type.errors.any? %>
    <div class="form-errors" data-testid="form-errors">
      <p><%= pluralize(food_type.errors.count, "error") %> prevented this food type from being saved:</p>
      <ul>
        <% food_type.errors.each do |error| %>
          <li data-testid="field-error"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Main div — name + icon preview + description %>
  <div class="show-panel" data-testid="<%= panel %>-panel-main">
    <div class="show-panel__section">
      <h2 class="show-panel__heading">Name</h2>
      <div class="form-group">
        <%= f.label :name, class: "sr-only" %>
        <%= f.text_field :name,
              class: "form-control #{'form-control--error' if food_type.errors[:name].any?}",
              data: { testid: "name-field" } %>
        <% if food_type.errors[:name].any? %>
          <span class="field-error" data-testid="field-error"><%= food_type.errors[:name].first %></span>
        <% end %>
      </div>
    </div>

    <% if FoodType::LUCIDE_VALID_ICONS.include?(food_type.icon) %>
      <div class="show-panel__section">
        <span class="event-type-icon-large" data-testid="icon-preview">
          <%= lucide_icon(food_type.icon, size: 64) %>
        </span>
      </div>
    <% end %>

    <div class="show-panel__section">
      <h2 class="show-panel__heading">Description</h2>
      <div class="form-group">
        <%= f.label :description, class: "sr-only" %>
        <%= f.text_area :description,
              class: "form-control #{'form-control--error' if food_type.errors[:description].any?}",
              rows: 4,
              data: { testid: "description-field" } %>
        <% if food_type.errors[:description].any? %>
          <span class="field-error" data-testid="field-error"><%= food_type.errors[:description].first %></span>
        <% end %>
      </div>
    </div>
  </div>

  <%# Metadata div %>
  <div class="show-panel" data-testid="<%= panel %>-panel-metadata">
    <div class="show-panel__section">
      <h3 class="show-meta-cell__label">Icon Name</h3>
      <div class="form-group">
        <%= f.label :icon, class: "sr-only" %>
        <%= f.text_field :icon,
              placeholder: "e.g. soup, fish, wheat",
              class: "form-control #{'form-control--error' if food_type.errors[:icon].any?}",
              data: { testid: "icon-field" } %>
        <% if food_type.errors[:icon].any? %>
          <span class="field-error" data-testid="field-error"><%= food_type.errors[:icon].first %></span>
        <% end %>
        <p class="form-hint">
          Find icon names at <%= link_to "lucide.dev/icons", "https://lucide.dev/icons/",
                target: "_blank", rel: "noopener noreferrer" %>.
        </p>
      </div>
    </div>
  </div>

  <%# Actions div %>
  <div class="show-panel show-panel--actions" data-testid="<%= panel %>-panel-actions">
    <%= link_to cancel_path, class: "btn btn-secondary" do %>
      <%= lucide_icon("circle-x", size: 16) %> Cancel
    <% end %>
    <span class="btn-divider">|</span>
    <button type="submit" class="btn btn-primary">
      <%= lucide_icon("save", size: 16) %> <%= submit_label %>
    </button>
  </div>
<% end %>
