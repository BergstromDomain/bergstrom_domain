                    "options": {
                      "byField": "app",
                      "mode": "outerTabular"
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "Current Branch - Main",
                      "binary": {
                        "left": {
                          "matcher": {
                            "id": "byName",
                            "options": "Value #Current Branch"
                          }
                        },
                        "operator": "-",
                        "right": {
                          "matcher": {
                            "id": "byName",
                            "options": "Value #Main"
                          }
                        }
                      },
                      "mode": "binary",
                      "reduce": {
                        "reducer": "sum"
                      },
                      "replaceFields": false
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time 1": true,
                        "Time 2": true
                      },
                      "includeByName": {},
                      "indexByName": {},
                      "renameByName": {
                        "Current Branch - Main": "Delta",
                        "Value #Current Branch": "Current Branch",
                        "Value #Main": "Main"
                      }
                    }
                  }
                }
              ]
            }
